<Window x:Class="LoginAppFramework.RecycleBinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LoginAppFramework"
        Title="Silinənlər"
        Width="940"
        Height="680"
        MinWidth="720"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Style="{StaticResource SurfaceCardStyle}"
            Margin="22"
            Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="20,18"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Silinənlər"
                                   Style="{StaticResource PageTitleTextStyle}"/>
                        <TextBlock Text="Silinmiş vəsaitlər 30 gün saxlanılır. Bu müddətdə bərpa edə və ya həmişəlik silə bilərsiniz."
                                   Style="{StaticResource PageSubtitleTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{StaticResource WarningSurfaceBrush}"
                            BorderBrush="{StaticResource WarningBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,5"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="RetentionSummaryTextBlock"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningTextBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceMutedBrush}"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14">
                <Grid>
                    <TextBox x:Name="SearchTextBox"
                             Width="330"
                             Height="38"
                             HorizontalAlignment="Left"
                             Tag="Kod, ad, seriya və ya silən istifadəçi..."
                             TextChanged="SearchTextBox_TextChanged"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="RestoreButton"
                                Content="Seçilmişləri bərpa et"
                                MinWidth="150"
                                Margin="0,0,8,0"
                                IsEnabled="False"
                                Style="{StaticResource PrimaryActionButton}"
                                Click="RestoreButton_Click"/>
                        <Button x:Name="PermanentDeleteButton"
                                Content="Həmişəlik sil"
                                MinWidth="115"
                                Margin="0,0,8,0"
                                IsEnabled="False"
                                Click="PermanentDeleteButton_Click"/>
                        <Button x:Name="EmptyBinButton"
                                Content="Hamısını sil"
                                MinWidth="100"
                                Click="EmptyBinButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <DataGrid x:Name="RecycleDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          SelectionChanged="RecycleDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kod"
                                            Binding="{Binding Code}"
                                            Width="120"/>
                        <DataGridTextColumn Header="Vəsait"
                                            Binding="{Binding Name}"
                                            Width="1.5*"/>
                        <DataGridTextColumn Header="Seriya"
                                            Binding="{Binding Serial}"
                                            Width="140"/>
                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}"
                                            Width="115"/>
                        <DataGridTextColumn Header="Silinmə tarixi"
                                            Binding="{Binding DeletedAtDisplay}"
                                            Width="145"/>
                        <DataGridTextColumn Header="Silən"
                                            Binding="{Binding DeletedBy}"
                                            Width="150"/>
                        <DataGridTextColumn Header="Qalan müddət"
                                            Binding="{Binding RetentionDisplay}"
                                            Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>

                <local:EmptyStateControl x:Name="EmptyState"
                                         Visibility="Collapsed"
                                         Icon="Delete"
                                         Title="Silinən vəsait yoxdur"
                                         Message="Silinən vəsaitlər 30 gün ərzində burada görünəcək."/>
            </Grid>

            <Border Grid.Row="3"
                    Padding="14,12"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock x:Name="CountTextBlock"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SubtleTextBrush}"/>
                    <Button Content="Bağla"
                            HorizontalAlignment="Right"
                            MinWidth="90"
                            IsCancel="True"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
