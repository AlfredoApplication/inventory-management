<UserControl x:Class="LoginAppFramework.EmptyStateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LoginAppFramework"
             Background="Transparent">
    <Border Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="28,22"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Center"
                    MaxWidth="420">
            <local:AppIcon Icon="{Binding Icon, RelativeSource={RelativeSource AncestorType=local:EmptyStateControl}}"
                           Size="34"
                           Foreground="{StaticResource SubtleTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=local:EmptyStateControl}}"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=local:EmptyStateControl}}"
                       Foreground="{StaticResource SubtleTextBrush}"
                       Margin="0,5,0,0"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
            <Button x:Name="ActionButton"
                    Content="{Binding ActionText, RelativeSource={RelativeSource AncestorType=local:EmptyStateControl}}"
                    HorizontalAlignment="Center"
                    Margin="0,14,0,0"
                    Click="ActionButton_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActionText, RelativeSource={RelativeSource AncestorType=local:EmptyStateControl}}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ActionText, RelativeSource={RelativeSource AncestorType=local:EmptyStateControl}}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
