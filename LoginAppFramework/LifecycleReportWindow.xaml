<Window x:Class="LoginAppFramework.LifecycleReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginAppFramework"
        mc:Ignorable="d"
        Title="Vəsait Həyat Dövrü Hesabatı"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MainScreenWindowStyle}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="{x:Type ListViewItem}"
               BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{StaticResource RowAlternateBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsEndOfLife}" Value="True">
                    <Setter Property="Background" Value="{StaticResource DangerSurfaceBrush}"/>
                    <Setter Property="ToolTip" Value="Bu vəsaitin istifadə müddəti bitib."/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowSelectedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="MenuButton"
                            Style="{StaticResource PrimaryActionButton}"
                            Height="40"
                            Padding="15,0"
                            Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <local:AppIcon Icon="Menu"
                                           Size="18"
                                           Foreground="{StaticResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="Menyu"
                                       Foreground="{StaticResource PrimaryForegroundBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="Vəsait Həyat Dövrü və Amortizasiya"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="İstifadə müddəti, amortizasiya və cari dəyər görünüşü"
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SurfaceCardStyle}"

            <local:ConnectionStatusBannerControl DockPanel.Dock="Top"/>

                    Margin="20"
                    Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource ControlBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="18">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock x:Name="TitleTextBlock"
                                               Text="Bütün Vəsaitlər"
                                               Style="{StaticResource PageTitleTextStyle}"/>
                                    <TextBlock x:Name="CountTextBlock"
                                               Text="0 element tapıldı"
                                               Style="{StaticResource PageSubtitleTextStyle}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <Button x:Name="ExportExcelButton"
                                        Grid.Column="1"
                                        Click="ExportExcelButton_Click"
                                        Style="{StaticResource PrimaryActionButton}"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        ToolTip="Cari siyahını Excel faylı kimi ixrac edin">
                                    <StackPanel Orientation="Horizontal">
                                        <local:AppIcon Icon="ExportExcel"
                                                       Size="17"
                                                       Margin="0,0,7,0"/>
                                        <TextBlock Text="Excel-ə İxrac"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <WrapPanel Margin="0,16,0,0">
                                <TextBox x:Name="SearchBox"
                                         Width="280"
                                         MinWidth="180"
                                         Tag="Axtarış..."
                                         TextChanged="Filter_Changed"
                                         ToolTip="Ad, istifadəçi və ya seriya üzrə axtarış..."
                                         Margin="0,0,18,8"/>

                                <RadioButton x:Name="AllAssetsFilterButton"
                                             Content="Bütün"
                                             GroupName="LifecycleFilter"
                                             IsChecked="True"
                                             Click="Filter_Changed"
                                             Margin="0,8,14,8"/>

                                <RadioButton x:Name="ActiveAssetsFilterButton"
                                             Content="İstifadə müddəti davam edən"
                                             GroupName="LifecycleFilter"
                                             Click="Filter_Changed"
                                             Margin="0,8,14,8"/>

                                <RadioButton x:Name="ExpiredAssetsFilterButton"
                                             Content="İstifadə müddəti bitmiş"
                                             GroupName="LifecycleFilter"
                                             Click="Filter_Changed"
                                             Margin="0,8,0,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <ListView x:Name="AssetReportListView"
                                  BorderThickness="0"
                                  MouseDoubleClick="AssetReportListView_MouseDoubleClick"
                                  AlternationCount="2"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Vəsaitin Kodu"
                                                    DisplayMemberBinding="{Binding VesaitinKodu}"
                                                    Width="120"/>
                                    <GridViewColumn Header="Vəsaitin Adı"
                                                    DisplayMemberBinding="{Binding Name}"
                                                    Width="170"/>
                                    <GridViewColumn Header="Təhkim Olunmuş Əməkdaş"
                                                    DisplayMemberBinding="{Binding AssignedUser, TargetNullValue=(Boşdur)}"
                                                    Width="190"/>
                                    <GridViewColumn Header="Alış tarixi"
                                                    DisplayMemberBinding="{Binding PurchaseDate, StringFormat=d}"
                                                    Width="110"/>
                                    <GridViewColumn Header="Amortizasiya müddəti (il)"
                                                    DisplayMemberBinding="{Binding UsefulLifeDisplay}"
                                                    Width="155"/>
                                    <GridViewColumn Header="İstifadə Müddətinin Sonu"
                                                    DisplayMemberBinding="{Binding EndOfLifeDateDisplay}"
                                                    Width="175"/>
                                    <GridViewColumn Header="Alış qiyməti"
                                                    DisplayMemberBinding="{Binding PurchaseCost, StringFormat=C, ConverterCulture=az-AZ}"
                                                    Width="120"/>
                                    <GridViewColumn Header="Aylıq amortizasiya" Width="135">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding MonthlyDepreciation, StringFormat=C, ConverterCulture=az-AZ}"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{StaticResource SubtleTextBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="İllik amortizasiya" Width="135">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding AnnualDepreciation, StringFormat=C, ConverterCulture=az-AZ}"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{StaticResource SubtleTextBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Yığılmış amortizasiya" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TotalDepreciation, StringFormat=C, ConverterCulture=az-AZ}"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{StaticResource DangerBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Cari dəyər" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CurrentValue, StringFormat=C, ConverterCulture=az-AZ}"
                                                           HorizontalAlignment="Right"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource SuccessBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <local:EmptyStateControl x:Name="NoResultsPanel"
                                                 Visibility="Collapsed"
                                                 Icon="Chart"
                                                 Title="Hesabat nəticəsi tapılmadı"
                                                 Message="Axtarışı və ya həyat dövrü filtrini dəyişin."/>
                    </Grid>
                </DockPanel>
            </Border>
        </DockPanel>

        <local:MainNavigationMenu x:Name="SharedNavigationMenu"
                                  CurrentPage="Lifecycle"/>

        <Border x:Name="LoadingOverlay"
                Background="{StaticResource GlassBackgroundBrush}"
                Visibility="Collapsed">
            <local:LoadingSkeletonControl/>
        </Border>

        <local:OperationProgressOverlay x:Name="OperationProgressOverlay"/>
    </Grid>
</Window>
