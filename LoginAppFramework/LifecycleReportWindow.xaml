<Window x:Class="LoginAppFramework.LifecycleReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginAppFramework"
        mc:Ignorable="d"
        Title="Vəsait Həyat Dövrü Hesabatı"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MainScreenWindowStyle}">

    <Window.Resources>
        <Style x:Key="ModernNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34495E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Storyboard x:Key="OpenMenu">
            <DoubleAnimation Storyboard.TargetName="SlideOutMenu" Storyboard.TargetProperty="Width" To="260" Duration="0:0:0.3"/>
        </Storyboard>
        <Storyboard x:Key="CloseMenu">
            <DoubleAnimation Storyboard.TargetName="SlideOutMenu" Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.3"/>
        </Storyboard>

        <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{StaticResource RowAlternateBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsEndOfLife}" Value="True">
                    <Setter Property="Background" Value="#FEF2F2"/>
                    <Setter Property="ToolTip" Value="Bu vəsaitin istifadə müddəti bitib."/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowSelectedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="0,0,0,1" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MenuButton" Style="{StaticResource PrimaryActionButton}" Height="40" Padding="15,0" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE700;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Menyu" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="1" Text="Vəsait Həyat Dövrü və Amortizasiya Hesabatı" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                </Grid>
            </Border>
            <Border Margin="25" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="8">
                <DockPanel Margin="20">
                    <Border DockPanel.Dock="Top" Margin="0,0,0,15" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TitleTextBlock" Text="Bütün Vəsaitlər" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                <TextBlock x:Name="CountTextBlock" Text="0 element tapıldı" FontSize="14" Foreground="{StaticResource BodyTextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" VerticalContentAlignment="Center" Width="200" ToolTip="Ad, İstifadəçi və ya Seriya üzrə axtarış..."/>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                    <RadioButton x:Name="AllAssetsFilterButton" Content="Bütün" GroupName="LifecycleFilter" IsChecked="True" Click="Filter_Changed" VerticalAlignment="Center"/>
                                    <RadioButton x:Name="ActiveAssetsFilterButton" Content="İstifadə Müddəti Davam Edən" GroupName="LifecycleFilter" Click="Filter_Changed" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <RadioButton x:Name="ExpiredAssetsFilterButton" Content="İstifadə Müddəti Bitmiş" GroupName="LifecycleFilter" Click="Filter_Changed" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ListView x:Name="AssetReportListView" BorderThickness="0" MouseDoubleClick="AssetReportListView_MouseDoubleClick" AlternationCount="2">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Vəsaitin Adı" DisplayMemberBinding="{Binding Name}" Width="130"/>
                                <GridViewColumn Header="Təhkim Olunmuş Əməkdaş" DisplayMemberBinding="{Binding AssignedUser, TargetNullValue=(Boşdur)}" Width="170"/>
                                <GridViewColumn Header="Alış tarixi" DisplayMemberBinding="{Binding PurchaseDate, StringFormat=d}" Width="100"/>

                                <!-- THE FIX IS HERE: Added the StringFormat -->
                                <GridViewColumn Header="Amortizasiya müddəti (il)" 
                                                DisplayMemberBinding="{Binding UsefulLifeInYears, StringFormat='{}{0} il'}" 
                                                Width="140"/>

                                <GridViewColumn Header="İstifadə Müddətinin Sonu" DisplayMemberBinding="{Binding EndOfLifeDate, StringFormat=d}" Width="170"/>
                                <GridViewColumn Header="Alış qiyməti" DisplayMemberBinding="{Binding PurchaseCost, StringFormat=C, ConverterCulture=az-AZ}" Width="110"/>

                                <GridViewColumn Header="Aylıq amortizasiya" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MonthlyDepreciation, StringFormat=C, ConverterCulture=az-AZ}" HorizontalAlignment="Right" Foreground="{StaticResource SubtleTextBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="İllik amortizasiya" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AnnualDepreciation, StringFormat=C, ConverterCulture=az-AZ}" HorizontalAlignment="Right" Foreground="{StaticResource SubtleTextBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Yığılmış amortizasiya" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TotalDepreciation, StringFormat=C, ConverterCulture=az-AZ}" HorizontalAlignment="Right" Foreground="#E74C3C"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Cari dəyər" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CurrentValue, StringFormat=C, ConverterCulture=az-AZ}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </DockPanel>
        <Border x:Name="MenuOverlay" Background="#000000" Opacity="0.3" Visibility="Collapsed" MouseDown="MenuOverlay_MouseDown"/>
        <Grid x:Name="SlideOutMenu" HorizontalAlignment="Left" Background="{StaticResource MenuBackgroundBrush}" Width="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Height="60">
                <TextBlock Text="Əsas Menyu" Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0"/>
                <Button x:Name="CloseMenuButton" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" Foreground="#AAAAAA" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="20" Click="CloseMenuButton_Click" Style="{StaticResource ModernNavButtonStyle}"/>
            </Grid>
            <StackPanel Grid.Row="1" Margin="5,0">
                <Button x:Name="DashboardButton" Click="DashboardButton_Click" Style="{StaticResource ModernNavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="İdarə Paneli" Margin="15,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="UsersButton" Click="UsersButton_Click" Style="{StaticResource ModernNavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="İşçilər" Margin="15,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="AssetsButton" Click="AssetsButton_Click" Style="{StaticResource ModernNavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE771;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Vəsaitlər" Margin="15,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="HistoryLogButton" Click="HistoryLogButton_Click" Style="{StaticResource ModernNavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Tarixçə" Margin="15,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ReportsButton" Click="ReportsButton_Click" Style="{StaticResource ModernNavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <!-- Bu ikon hesabatları təmsil edir -->
                        <TextBlock Text="&#xE9F9;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Hesabatlar" Margin="15,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="LifecycleReportButton" Style="{StaticResource ModernNavButtonStyle}" Background="#34495E" Click="LifecycleReportButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE78B;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Həyat Dövrü Hesabatı" Margin="15,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="5,0,5,10">
                <Separator Background="#34495E" Margin="0,10"/>
                <Button x:Name="UserProfileButton" Style="{StaticResource ModernNavButtonStyle}" Click="UserProfileButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="UserProfileIcon" Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="28" VerticalAlignment="Center"/>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock x:Name="UserProfileName" Text="Admin User" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Text="Onlayn" Foreground="LightGreen"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <Popup x:Name="UserSwitchPopup" StaysOpen="False" Placement="Top" AllowsTransparency="True" PopupAnimation="Fade" PlacementTarget="{Binding ElementName=UserProfileButton}">
            <Border Background="#34495E" CornerRadius="5" BorderBrush="#4A6582" BorderThickness="1" MinWidth="250" Margin="0,0,5,5">
                <StackPanel>
                    <Button x:Name="SwitchUserButton" Click="SwitchUserButton_Click" Style="{StaticResource ModernNavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D4;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="İstifadəçini Dəyiş" Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Separator Background="#4A6582" Margin="5,0"/>
                    <Button x:Name="LogoutButton" Click="LogoutButton_Click" Style="{StaticResource ModernNavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Çıxış" Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>