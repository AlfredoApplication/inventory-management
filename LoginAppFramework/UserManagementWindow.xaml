<Window x:Class="LoginAppFramework.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application User Management" Height="Auto" Width="400"
        WindowStartupLocation="CenterOwner" SizeToContent="Height"
        Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Manage Application Users" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15" Foreground="{StaticResource PrimaryTextBrush}"/>

        <ListView Grid.Row="1" x:Name="UsersListView" MaxHeight="200" Margin="0,0,0,15" SelectionChanged="UsersListView_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Username" DisplayMemberBinding="{Binding Username}" Width="150"/>
                    <GridViewColumn Header="Full Name" DisplayMemberBinding="{Binding FullName}" Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="2" x:Name="DetailPanel">
            <StackPanel>
                <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="4" Padding="15">
                    <StackPanel>
                        <TextBlock Text="User Details" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Label Content="Username:"/>
                        <TextBox x:Name="UsernameTextBox"/>
                        <Label Content="Full Name:"/>
                        <TextBox x:Name="FullNameTextBox" Margin="0,0,0,10"/>
                        <Label Content="Employee Code (e.g., per_kod):"/>
                        <TextBox x:Name="EmployeeCodeTextBox" Margin="0,0,0,10"/>
                        <Label Content="Set/Change Password:"/>
                        <PasswordBox x:Name="PasswordBox"/>
                        <TextBlock Text="Leave blank to keep the current password unchanged." FontSize="11" FontStyle="Italic" Foreground="Gray"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="NewUserButton" Content="New User" Click="NewUserButton_Click"/>
                    <Button x:Name="SaveButton" Content="Save Changes" Click="SaveButton_Click" IsDefault="True" FontWeight="SemiBold" Background="{StaticResource SuccessBrush}" Foreground="{StaticResource PrimaryForegroundBrush}" Margin="10,0,0,0"/>
                    <Button x:Name="DeleteButton" Content="Delete User" Click="DeleteButton_Click" Background="{StaticResource DangerBrush}" Foreground="{StaticResource PrimaryForegroundBrush}" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>