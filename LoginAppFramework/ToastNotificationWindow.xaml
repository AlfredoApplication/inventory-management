<Window x:Class="LoginAppFramework.ToastNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LoginAppFramework"
        Width="390"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="True">
    <Border x:Name="ToastBorder"
            Background="{StaticResource InfoSurfaceBrush}"
            BorderBrush="{StaticResource InfoBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="3"
                              Opacity="0.16"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="IconContainer"
                    Width="36"
                    Height="36"
                    CornerRadius="10"
                    Background="{StaticResource PanelBackgroundBrush}"
                    Margin="0,0,12,0">
                <local:AppIcon x:Name="IconVisual"
                               Icon="Info"
                               Size="19"
                               Foreground="{StaticResource InfoTextBrush}"/>
            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock x:Name="TitleTextBlock"
                           Text="Məlumat"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           Margin="0,0,0,2"/>
                <TextBlock x:Name="MessageTextBlock"
                           Foreground="{StaticResource BodyTextBrush}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           MaxWidth="290"/>
            </StackPanel>

            <Button Grid.Column="2"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Margin="10,-4,-4,0"
                    VerticalAlignment="Top"
                    ToolTip="Bağla"
                    Click="CloseButton_Click">
                <local:AppIcon Icon="Close" Size="13"/>
            </Button>
        </Grid>
    </Border>
</Window>
