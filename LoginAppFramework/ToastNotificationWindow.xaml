<Window x:Class="LoginAppFramework.ToastNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LoginAppFramework"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="True">
    <Border Background="#FFECFDF3"
            BorderBrush="#FF22A06B"
            BorderThickness="1"
            CornerRadius="10"
            Padding="16"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                              ShadowDepth="3"
                              Opacity="0.22"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <local:AppIcon Icon="Success"
                           Size="19"
                           Foreground="#FF14804A"
                           VerticalAlignment="Top"
                           Margin="0,2,12,0"/>
            <TextBlock x:Name="MessageTextBlock"
                       Grid.Column="1"
                       Foreground="#FF172B22"
                       FontSize="14"
                       TextWrapping="Wrap"
                       MaxWidth="320"/>
        </Grid>
    </Border>
</Window>