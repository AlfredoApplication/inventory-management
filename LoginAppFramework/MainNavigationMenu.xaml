<UserControl x:Class="LoginAppFramework.MainNavigationMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <UserControl.Resources>
        <Style x:Key="SharedNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#16A085"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Border Background="#66000000"
                MouseDown="Overlay_MouseDown"/>

        <Border HorizontalAlignment="Left"
                Width="320"
                Background="{StaticResource MenuBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="Əsas Menyu"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="20,0"/>

                    <Button HorizontalAlignment="Right"
                            Width="58"
                            Content="&#xE8BB;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="17"
                            Foreground="White"
                            Style="{StaticResource SharedNavButtonStyle}"
                            Click="CloseButton_Click"/>
                </Grid>

                <StackPanel Grid.Row="1" Margin="6,4">
                    <Button x:Name="DashboardButton"
                            Style="{StaticResource SharedNavButtonStyle}"
                            Click="DashboardButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="17"/>
                            <TextBlock Text="İdarə Paneli" Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="WorkersButton"
                            Style="{StaticResource SharedNavButtonStyle}"
                            Click="WorkersButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons" FontSize="17"/>
                            <TextBlock Text="İşçilər" Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="AssetsButton"
                            Style="{StaticResource SharedNavButtonStyle}"
                            Click="AssetsButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE771;" FontFamily="Segoe Fluent Icons" FontSize="17"/>
                            <TextBlock Text="Vəsaitlər" Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="HistoryButton"
                            Style="{StaticResource SharedNavButtonStyle}"
                            Click="HistoryButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" FontSize="17"/>
                            <TextBlock Text="Tarixçə" Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ReportsButton"
                            Style="{StaticResource SharedNavButtonStyle}"
                            Click="ReportsButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe Fluent Icons" FontSize="17"/>
                            <TextBlock Text="Hesabatlar" Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="UserManagementButton"
                            Style="{StaticResource SharedNavButtonStyle}"
                            Visibility="Collapsed"
                            Click="UserManagementButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="17"/>
                            <TextBlock Text="İstifadəçi İdarəetməsi" Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="6,0,6,12">
                    <Separator Margin="6,8"
                               Background="#55FFFFFF"/>

                    <Button x:Name="UserProfileButton"
                            Style="{StaticResource SharedNavButtonStyle}"
                            Click="UserProfileButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="27"
                                       VerticalAlignment="Center"/>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock x:Name="UserProfileName"
                                           Text="İstifadəçi"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="UserRoleText"
                                           Text="Onlayn"
                                           Foreground="LightGreen"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Popup x:Name="UserPopup"
               StaysOpen="False"
               PlacementTarget="{Binding ElementName=UserProfileButton}"
               Placement="Top"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{StaticResource MenuBackgroundBrush}"
                    BorderBrush="{StaticResource PrimaryBrushHover}"
                    BorderThickness="1"
                    CornerRadius="6"
                    MinWidth="250"
                    Margin="0,0,0,6">
                <StackPanel>
                    <Button Style="{StaticResource SharedNavButtonStyle}"
                            Click="SwitchUserButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D4;" FontFamily="Segoe Fluent Icons"/>
                            <TextBlock Text="İstifadəçini Dəyiş" Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Separator Background="#55FFFFFF"/>
                    <Button Style="{StaticResource SharedNavButtonStyle}"
                            Click="LogoutButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons"/>
                            <TextBlock Text="Çıxış" Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>