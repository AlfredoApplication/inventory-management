<UserControl x:Class="LoginAppFramework.MainNavigationMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LoginAppFramework"
             Visibility="Collapsed"
             PreviewKeyDown="MainNavigationMenu_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="SharedNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryBrushHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Border Background="{StaticResource OverlayBrush}"
                MouseDown="Overlay_MouseDown"/>

        <Border x:Name="NavigationPanel"
                HorizontalAlignment="Left"
                Width="288"
                Background="{StaticResource MenuBackgroundBrush}"
                CornerRadius="0,14,14,0"
                KeyboardNavigation.TabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Cycle">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="Əsas Menyu"
                               Foreground="White"
                               FontSize="19"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="20,0"/>

                    <Button HorizontalAlignment="Right"
                            Width="58"
                            Foreground="White"
                            Style="{StaticResource SharedNavButtonStyle}"
                            Click="CloseButton_Click">
                        <local:AppIcon Icon="Close" Size="18"/>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Margin="10,8">
                    <Button x:Name="DashboardButton"
                            Style="{StaticResource SharedNavButtonStyle}"
                            Click="DashboardButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <local:AppIcon Icon="Dashboard" Size="18"/>
                            <TextBlock Text="İdarə Paneli" Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="WorkersButton"
                            Style="{StaticResource SharedNavButtonStyle}"
                            Click="WorkersButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <local:AppIcon Icon="Workers" Size="18"/>
                            <TextBlock Text="İşçilər" Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="AssetsButton"
                            Style="{StaticResource SharedNavButtonStyle}"
                            Click="AssetsButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <local:AppIcon Icon="Assets" Size="18"/>
                            <TextBlock Text="Vəsaitlər" Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="HistoryButton"
                            Style="{StaticResource SharedNavButtonStyle}"
                            Click="HistoryButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <local:AppIcon Icon="History" Size="18"/>
                            <TextBlock Text="Tarixçə" Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="LifecycleButton"
                            Style="{StaticResource SharedNavButtonStyle}"
                            Click="LifecycleButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <local:AppIcon Icon="Chart" Size="18"/>
                            <TextBlock Text="Həyat Dövrü" Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ReportsButton"
                            Style="{StaticResource SharedNavButtonStyle}"
                            Click="ReportsButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <local:AppIcon Icon="Reports" Size="18"/>
                            <TextBlock Text="Hesabatlar" Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="UserManagementButton"
                            Style="{StaticResource SharedNavButtonStyle}"
                            Visibility="Collapsed"
                            Click="UserManagementButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <local:AppIcon Icon="UserManagement" Size="18"/>
                            <TextBlock Text="İstifadəçi İdarəetməsi" Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="10,0,10,14">
                    <Separator Margin="6,8"
                               Background="{StaticResource GlassBorderBrush}"/>

                    <Button x:Name="UserProfileButton"
                            Style="{StaticResource SharedNavButtonStyle}"
                            Click="UserProfileButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <local:AppIcon Icon="User"
                                           Size="28"
                                           VerticalAlignment="Center"/>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock x:Name="UserProfileName"
                                           Text="İstifadəçi"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="UserRoleText"
                                           Text="Onlayn"
                                           Foreground="{StaticResource MenuSuccessTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Popup x:Name="UserPopup"
               StaysOpen="False"
               PlacementTarget="{Binding ElementName=UserProfileButton}"
               Placement="Top"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{StaticResource MenuBackgroundBrush}"
                    BorderBrush="{StaticResource PrimaryBrushHover}"
                    BorderThickness="1"
                    CornerRadius="6"
                    MinWidth="250"
                    Margin="0,0,0,6">
                <StackPanel>
                    <Button Style="{StaticResource SharedNavButtonStyle}"
                            Click="SwitchUserButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <local:AppIcon Icon="SwitchUser" Size="18"/>
                            <TextBlock Text="İstifadəçini Dəyiş" Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Separator Background="#55FFFFFF"/>
                    <Button Style="{StaticResource SharedNavButtonStyle}"
                            Click="LogoutButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <local:AppIcon Icon="Logout" Size="18"/>
                            <TextBlock Text="Proqramdan Çıxış" Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>