<Window x:Class="LoginAppFramework.PrintQrCodesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Barkodları Çap Et" Height="800" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <DockPanel Margin="10">

            <!-- Üst Panel: Düymələr və Tənzimləmələr -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="PrintButton" Content="Çap Et" Padding="15,5" Click="PrintButton_Click" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                    <TextBlock x:Name="CountTextBlock" VerticalAlignment="Center" Margin="20,0,0,0" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Ölçü Tənzimləmə Paneli (XƏTANI HƏLL EDƏN HİSSƏ BURADIR) -->
                <Border Background="#F0F0F0" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Kağız Eni (mm):" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                        <!-- WidthTextBox buradadır -->
                        <TextBox x:Name="WidthTextBox" Text="50" Width="45" VerticalAlignment="Center" TextAlignment="Center"/>

                        <TextBlock Text="Hündürlük (mm):" VerticalAlignment="Center" Margin="20,0,5,0" FontWeight="SemiBold"/>
                        <!-- HeightTextBox buradadır -->
                        <TextBox x:Name="HeightTextBox" Text="25" Width="45" VerticalAlignment="Center" TextAlignment="Center"/>

                        <Button Content="Yenilə (Bax)" Margin="20,0,0,0" Padding="15,2" Click="RefreshButton_Click"/>

                        <TextBlock Text="* Rəqəmləri dəyişib 'Yenilə' basın. Millimetr (mm) ilə yazın." 
                                   VerticalAlignment="Center" Margin="15,0,0,0" Foreground="Gray" FontStyle="Italic"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border x:Name="printArea" Background="White">
                    <WrapPanel x:Name="QrCodePanel" Margin="10"/>
                </Border>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>