<Window x:Class="LoginAppFramework.PrintQrCodesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginAppFramework"
        mc:Ignorable="d"
        Title="QR Kodları Çap Et" Height="800" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <DockPanel Margin="10">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="PrintButton" Content="Çap Et" Padding="10,5" Click="PrintButton_Click"/>

                <!-- THE FIX: Added x:Name="CountTextBlock" to this TextBlock -->
                <TextBlock x:Name="CountTextBlock" Text="Seçilmiş vəsaitlər üçün yaradılmış QR kodlar" VerticalAlignment="Center" Margin="20,0,0,0" FontWeight="SemiBold"/>
            </StackPanel>

            <ScrollViewer x:Name="scrollViewer" VerticalScrollBarVisibility="Auto">
                <Border x:Name="printArea" Background="White">
                    <WrapPanel x:Name="QrCodePanel" Margin="10"/>
                </Border>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>