<Window x:Class="LoginAppFramework.PrintQrCodesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LoginAppFramework"
        Title="QR / Barkod Çapı"
        Width="1180"
        Height="820"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="QR / Barkod Çapı"
                               Style="{StaticResource PageTitleTextStyle}"/>
                    <TextBlock Text="Preset seçin və printer layout-unu əvvəlcədən yoxlayın."
                               Style="{StaticResource PageSubtitleTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,18"/>

                    <TextBlock Text="Preset"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <ComboBox x:Name="PresetComboBox"
                              Height="38"
                              DisplayMemberPath="Name"
                              SelectionChanged="PresetComboBox_SelectionChanged"/>

                    <TextBlock Text="Kod formatı"
                               FontWeight="SemiBold"
                               Margin="0,14,0,6"/>
                    <ComboBox x:Name="FormatComboBox"
                              Height="38">
                        <ComboBoxItem Content="Code 128" Tag="Code128" IsSelected="True"/>
                        <ComboBoxItem Content="QR Code" Tag="QrCode"/>
                    </ComboBox>

                    <TextBlock Text="Kağız rejimi"
                               FontWeight="SemiBold"
                               Margin="0,14,0,6"/>
                    <ComboBox x:Name="PaperModeComboBox"
                              Height="38"
                              SelectionChanged="PaperModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Etiket printeri" Tag="Label" IsSelected="True"/>
                        <ComboBoxItem Content="A4 vərəq" Tag="A4"/>
                    </ComboBox>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="En (mm)"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="Hündürlük (mm)"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="WidthTextBox"
                                 Grid.Row="1"
                                 Grid.Column="0"
                                 Height="38"
                                 Text="50"/>
                        <TextBox x:Name="HeightTextBox"
                                 Grid.Row="1"
                                 Grid.Column="2"
                                 Height="38"
                                 Text="25"/>
                    </Grid>

                    <Border x:Name="A4SettingsPanel"
                            Background="{StaticResource SurfaceMutedBrush}"
                            BorderBrush="{StaticResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,14,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="A4 grid"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Sütun"
                                           FontSize="11"/>
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="Sətir"
                                           FontSize="11"/>
                                <TextBox x:Name="ColumnsTextBox"
                                         Grid.Row="1"
                                         Grid.Column="0"
                                         Text="3"/>
                                <TextBox x:Name="RowsTextBox"
                                         Grid.Row="1"
                                         Grid.Column="2"
                                         Text="8"/>

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="Səhifə margin (mm)"
                                           FontSize="11"/>
                                <TextBlock Grid.Row="3" Grid.Column="2"
                                           Text="Etiket arası (mm)"
                                           FontSize="11"/>
                                <TextBox x:Name="MarginTextBox"
                                         Grid.Row="4"
                                         Grid.Column="0"
                                         Text="8"/>
                                <TextBox x:Name="GapTextBox"
                                         Grid.Row="4"
                                         Grid.Column="2"
                                         Text="2"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Şrift ölçüsü"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="Kod sahəsi (%)"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="FontSizeTextBox"
                                 Grid.Row="1"
                                 Grid.Column="0"
                                 Text="7"/>
                        <TextBox x:Name="CodeAreaTextBox"
                                 Grid.Row="1"
                                 Grid.Column="2"
                                 Text="68"/>
                    </Grid>

                    <CheckBox x:Name="ShowAssetNameCheckBox"
                              Content="Vəsait adını etiketdə göstər"
                              IsChecked="True"
                              Margin="0,14,0,0"/>

                    <Button Content="Preview yenilə"
                            Margin="0,18,0,0"
                            Height="40"
                            Click="RefreshButton_Click"/>

                    <TextBlock x:Name="ValidationTextBlock"
                               Foreground="{StaticResource DangerTextBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="0,10,0,0"/>

                    <Border Height="1"
                            Background="{StaticResource ControlBorderBrush}"
                            Margin="0,18,0,14"/>

                    <TextBlock x:Name="CountTextBlock"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BodyTextBrush}"/>
                    <TextBlock x:Name="PageSummaryTextBlock"
                               Foreground="{StaticResource SubtleTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>

                    <Button x:Name="PrintButton"
                            Content="Çap Et"
                            Height="44"
                            Margin="0,16,0,0"
                            Style="{StaticResource SuccessActionButton}"
                            FontWeight="SemiBold"
                            Click="PrintButton_Click"/>
                    <Button Content="Bağla"
                            Height="38"
                            Margin="0,8,0,0"
                            IsCancel="True"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="2"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,12">
                    <TextBlock Text="Çap preview"
                               Style="{StaticResource SectionTitleTextStyle}"/>
                    <TextBlock Text="Ağ sahə printerə gedəcək real səhifə/etiket layout-udur."
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource SubtleTextBrush}"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="{StaticResource SurfaceMutedBrush}">
                    <StackPanel x:Name="PreviewPagesPanel"
                                HorizontalAlignment="Center"
                                Margin="18"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
