<Window x:Class="LoginAppFramework.SelectWorkerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Təhkim Ediləcək İşçini Seçin"
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI">
    <Border Style="{StaticResource SurfaceCardStyle}" Margin="15" Padding="18">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- NEW: Header with Title and Search Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Siyahıdan aktiv bir işçi seçin:" 
                       Style="{StaticResource SectionTitleTextStyle}"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource PrimaryTextBrush}"/>

            <TextBox x:Name="SearchBox" Grid.Column="1" Width="250"
                     TextChanged="SearchBox_TextChanged"
                     VerticalAlignment="Center"
                     Tag="Axtarış..." ToolTip="Ad, vəzifə və ya departament üzrə axtarış..."/>
        </Grid>

        <Grid Grid.Row="1">
            <ListView x:Name="WorkersListView" 
                      MouseDoubleClick="WorkersListView_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Personal Kodu" DisplayMemberBinding="{Binding per_kod}" Width="120"/>
                        <GridViewColumn Header="Tam Ad" DisplayMemberBinding="{Binding per_adiper_soyadi}" Width="200"/>
                        <GridViewColumn Header="Vəzifə" DisplayMemberBinding="{Binding pgk_gorev_adi}" Width="200"/>
                        <GridViewColumn Header="Departament" DisplayMemberBinding="{Binding pdp_adi}" Width="200"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <local:EmptyStateControl x:Name="EmptyState"
                                     Visibility="Collapsed"
                                     Icon="Workers"
                                     Title="Uyğun işçi tapılmadı"
                                     Message="Axtarış sözünü dəyişərək yenidən yoxlayın."/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="SelectButton" Content="Seç" Width="90" IsDefault="True" Style="{StaticResource PrimaryActionButton}" Click="SelectButton_Click"/>
            <Button Content="Ləğv et" Width="90" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
        </Grid>
    </Border>
</Window>