<Window x:Class="LoginAppFramework.AddMaintenanceRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Texniki Xidmət Qeydi" Height="Auto" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" 
        Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" x:Name="AssetTitle" Text="Qeyd: [Vəsait Adı]" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

        <Label Grid.Row="1" Content="Texniki Xidmət Tarixi:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <DatePicker x:Name="MaintenanceDatePicker" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Padding="5"/>

        <Label Grid.Row="2" Content="Texniki Xidmət Növü:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <ComboBox x:Name="MaintenanceTypeComboBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Padding="5"/>

        <Label Grid.Row="3" Content="Xərc:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="CostTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Padding="5" Text="0"/>

        <Label Grid.Row="4" Content="Təsvir:" VerticalAlignment="Top" Margin="0,0,10,10"/>
        <TextBox x:Name="DescriptionTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" Padding="5" TextWrapping="Wrap" Height="80" VerticalScrollBarVisibility="Auto"/>

        <!-- UPDATED BUTTONS SECTION -->
        <Grid Grid.Row="5" Grid.ColumnSpan="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Delete Button (Left) -->
            <Button x:Name="DeleteButton" Content="Sil" Width="80" 
                    Background="{StaticResource DangerBrush}" Foreground="{StaticResource PrimaryForegroundBrush}"
                    Click="DeleteButton_Click" Visibility="Collapsed" ToolTip="Bu qeydi həmişəlik silin."/>

            <!-- Save and Cancel Buttons (Right) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Yadda Saxla" Width="120" IsDefault="True" Click="SaveButton_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,0,10,0"/>
                <Button Content="Ləğv et" Width="80" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>