<Window x:Class="LoginAppFramework.AddEditWorkerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İşçi Məlumatları"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="165"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0"
               Content="Tam Ad:"
               VerticalAlignment="Center"
               Margin="0,0,10,10"/>
        <TextBox x:Name="FullNameTextBox"
                 Grid.Row="0"
                 Grid.Column="1"
                 Margin="0,0,0,10"
                 Padding="5"
                 FontSize="14"
                 Text="{Binding per_adiper_soyadi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Row="1"
               Content="İşçi Kodu (per_kod):"
               VerticalAlignment="Center"
               Margin="0,0,10,10"/>
        <TextBox x:Name="LogonNameTextBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 Margin="0,0,0,10"
                 Padding="5"
                 FontSize="14"
                 Text="{Binding per_kod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="İşçi kodu yaradıldıqdan sonra dəyişdirilə bilməz."/>

        <Label Grid.Row="2"
               Content="Vəzifə:"
               VerticalAlignment="Center"
               Margin="0,0,10,10"/>
        <TextBox x:Name="PositionTextBox"
                 Grid.Row="2"
                 Grid.Column="1"
                 Margin="0,0,0,10"
                 Padding="5"
                 FontSize="14"
                 Text="{Binding pgk_gorev_adi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Row="3"
               Content="Departament:"
               VerticalAlignment="Center"
               Margin="0,0,10,10"/>
        <ComboBox x:Name="DepartmentComboBox"
                  Grid.Row="3"
                  Grid.Column="1"
                  Margin="0,0,0,10"
                  Padding="5"
                  FontSize="14"
                  Text="{Binding pdp_adi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  IsEditable="True"/>

        <TextBlock x:Name="ValidationTextBlock"
                   Grid.Row="4"
                   Grid.ColumnSpan="2"
                   Visibility="Collapsed"
                   Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap"
                   Margin="0,2,0,8"/>

        <StackPanel Grid.Row="5"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Yadda Saxla"
                    Width="110"
                    Margin="0,0,10,0"
                    Style="{StaticResource PrimaryActionButton}"
                    IsDefault="True"
                    Click="SaveButton_Click"/>
            <Button Content="Ləğv et"
                    Width="90"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>