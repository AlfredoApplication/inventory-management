<Window x:Class="LoginAppFramework.DateSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="Tarix seçin"
        Height="360"
        Width="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI">
    <Border Style="{StaticResource SurfaceCardStyle}" Margin="16" Padding="16">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   Text="Tarix seçin"
                   Style="{StaticResource SectionTitleTextStyle}"
                   Foreground="{StaticResource PrimaryTextBrush}"
                   Margin="0,0,0,10"/>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="5">
            <wfi:WindowsFormsHost x:Name="CalendarHost"/>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Ləğv et"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>
            <Button Content="Seç"
                    Style="{StaticResource PrimaryActionButton}"
                    Click="SelectButton_Click"/>
        </StackPanel>
        </Grid>
    </Border>
</Window>