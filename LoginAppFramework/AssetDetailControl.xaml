<UserControl x:Class="LoginAppFramework.AssetDetailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LoginAppFramework"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="500"
             FontFamily="Segoe UI" Background="{StaticResource PanelBackgroundBrush}">
    <Grid>
        <TextBlock x:Name="SelectAssetPrompt" Text="Məlumatları görmək üçün siyahıdan bir vəsait seçin." FontSize="18" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Visibility="Visible"/>
        <DockPanel x:Name="DetailViewPanel" Margin="20" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
                <Button x:Name="EditAssetButton" Content="Vəsaiti Dəyiş" Click="EditAssetButton_Click"/>
                <Button x:Name="DeleteAssetButton" Content="Sil" Click="DeleteAssetButton_Click" Style="{StaticResource DangerActionButton}" Margin="10,0,0,0" ToolTip="Bu vəsait qeydini həmişəlik silin."/>
                <Button x:Name="CloseDetailPanelButton"
        Click="CloseDetailPanelButton_Click"
        ToolTip="Detallı Görünüşü Bağla"
        Background="Transparent"
        BorderThickness="0"
        Foreground="{StaticResource BodyTextBrush}"
        Width="32"
        Height="32"
        Margin="10,-5,-10,-5">
    <local:AppIcon Icon="Close" Size="17"/>
</Button>
            </StackPanel>
            <TabControl>
                <TabItem Header="Məlumatlar">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Vəsait Məlumatı" Style="{StaticResource SectionTitleTextStyle}"/>
                            <Border BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Vəsaitin Kodu:" FontWeight="SemiBold" Margin="0,0,10,10" VerticalAlignment="Center"/>
                                    <Grid Grid.Row="0" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="VesaitinKoduValue" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Button x:Name="GenerateBarcodeButton" Grid.Column="1" Click="GenerateBarcodeButton_Click" Background="Transparent" BorderThickness="0" ToolTip="Bu vəsait üçün barkod yarat">
                                            <local:AppIcon Icon="Location" Size="19" Foreground="{StaticResource BodyTextBrush}"/>
                                        </Button>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="Vəsaitin Adı:" FontWeight="SemiBold" Margin="0,0,10,10" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="VesaitinAdiValue" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Top"/>

                                    <TextBlock Grid.Row="2" Text="Seriya Nömrəsi:" FontWeight="SemiBold" Margin="0,0,10,10" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="SeriyaNomresiValue" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Top"/>

                                    <TextBlock Grid.Row="3" Text="Kateqoriya:" FontWeight="SemiBold" Margin="0,0,10,10" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="KateqoriyaValue" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Top"/>

                                    <TextBlock Grid.Row="4" Text="Bölmə/Şöbə:" FontWeight="SemiBold" Margin="0,0,10,10" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="DepartmentOrSectionValue" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Top"/>

                                    <TextBlock Grid.Row="5" Text="Yerləşmə Yeri:" FontWeight="SemiBold" Margin="0,0,10,10" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="YerlesmeYeriValue" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Top"/>

                                    <TextBlock Grid.Row="6" Text="Ərazi:" FontWeight="SemiBold" Margin="0,0,10,10" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="EraziValue" Grid.Row="6" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Top"/>

                                    <TextBlock Grid.Row="7" Text="Alınma Tarixi:" FontWeight="SemiBold" Margin="0,0,10,10" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="AlinmaTarixiValue" Grid.Row="7" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Top"/>

                                    <TextBlock Grid.Row="8" Text="Status:" FontWeight="SemiBold" Margin="0,0,10,10" VerticalAlignment="Top"/>
                                    <local:StatusBadgeControl x:Name="StatusBadge"
                                                              Grid.Row="8"
                                                              Grid.Column="1"
                                                              VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="CustomFieldsSection" Margin="0,20,0,0" Visibility="Collapsed">
                                <TextBlock Text="Kateqoriyaya Xas Məlumatlar" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                <Border BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,10,0,0">
                                    <StackPanel x:Name="CustomFieldsPanel"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Təhkim Olunmuş İstifadəçi" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,20,0,10"/>
                            <Border x:Name="AssignedUserPanel" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15" Visibility="Collapsed" MouseLeftButtonDown="AssignedUserPanel_MouseLeftButtonDown" Cursor="Hand" ToolTip="İstifadəçi məlumatlarına baxmaq üçün klikləyin">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <local:AppIcon Icon="User" Size="48" VerticalAlignment="Center"/>
                                        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="UserNameTextBlock" FontWeight="SemiBold" FontSize="18"/>
                                            <TextBlock x:Name="UserPositionTextBlock" Foreground="{StaticResource SubtleTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                                        <Button x:Name="ReassignButton" Content="Yenidən Təhkim et" Click="ReassignButton_Click"/>
                                        <Button x:Name="UnassignButton" Content="Təhkimi Ləğv et" Click="UnassignButton_Click" Style="{StaticResource WarningActionButton}" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border x:Name="UnassignedUserPanel" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="25" Background="{StaticResource SurfaceMutedBrush}" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Bu vəsait hazırda heç kimə təhkim olunmayıb." TextAlignment="Center" Foreground="{StaticResource SubtleTextBrush}"/>
                                    <Button x:Name="AssignButton" Content="İstifadəçiyə Təhkim et..." Click="AssignOrReassignButton_Click" Style="{StaticResource SuccessActionButton}" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                                </StackPanel>
                            </Border>


                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Aktivlik">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="10">
                        <StackPanel>
                            <TextBlock Text="Vəsait Aktivliyi"
                                       Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBlock Text="Alış, təhkimat və texniki xidmət hadisələri bir xronologiyada göstərilir."
                                       Style="{StaticResource PageSubtitleTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,16"/>

                            <ItemsControl x:Name="ActivityTimelineList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="2"
                                                    Background="{StaticResource ControlBorderBrush}"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,28,0,-8"/>

                                            <Border x:Name="ActivityIconBorder"
                                                    Grid.Column="0"
                                                    Width="34"
                                                    Height="34"
                                                    CornerRadius="17"
                                                    Background="{StaticResource InfoSurfaceBrush}"
                                                    BorderBrush="{StaticResource InfoBorderBrush}"
                                                    BorderThickness="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top">
                                                <local:AppIcon x:Name="ActivityIcon"
                                                               Icon="{Binding Icon}"
                                                               Size="17"
                                                               Foreground="{StaticResource InfoTextBrush}"/>
                                            </Border>

                                            <Border Grid.Column="1"
                                                    Background="{StaticResource PanelBackgroundBrush}"
                                                    BorderBrush="{StaticResource ControlBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="13,11"
                                                    Margin="8,0,0,10">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Date, StringFormat='dd.MM.yyyy HH:mm'}"
                                                                   Foreground="{StaticResource SubtleTextBrush}"
                                                                   FontSize="11"
                                                                   Margin="12,0,0,0"/>
                                                    </Grid>

                                                    <TextBlock Text="{Binding Description}"
                                                               Foreground="{StaticResource BodyTextBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,5,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Description}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <TextBlock Text="{Binding Actor}"
                                                               Foreground="{StaticResource SubtleTextBrush}"
                                                               FontSize="11"
                                                               Margin="0,5,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Actor}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Actor}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>

                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Assigned">
                                                <Setter TargetName="ActivityIconBorder" Property="Background" Value="{StaticResource SuccessSurfaceBrush}"/>
                                                <Setter TargetName="ActivityIconBorder" Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}"/>
                                                <Setter TargetName="ActivityIcon" Property="Foreground" Value="{StaticResource SuccessTextBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Unassigned">
                                                <Setter TargetName="ActivityIconBorder" Property="Background" Value="{StaticResource WarningSurfaceBrush}"/>
                                                <Setter TargetName="ActivityIconBorder" Property="BorderBrush" Value="{StaticResource WarningBorderBrush}"/>
                                                <Setter TargetName="ActivityIcon" Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Reassigned">
                                                <Setter TargetName="ActivityIconBorder" Property="Background" Value="{StaticResource InfoSurfaceBrush}"/>
                                                <Setter TargetName="ActivityIconBorder" Property="BorderBrush" Value="{StaticResource InfoBorderBrush}"/>
                                                <Setter TargetName="ActivityIcon" Property="Foreground" Value="{StaticResource InfoTextBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Maintenance">
                                                <Setter TargetName="ActivityIconBorder" Property="Background" Value="{StaticResource WarningSurfaceBrush}"/>
                                                <Setter TargetName="ActivityIconBorder" Property="BorderBrush" Value="{StaticResource WarningBorderBrush}"/>
                                                <Setter TargetName="ActivityIcon" Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <local:EmptyStateControl x:Name="ActivityEmptyState"
                                                     Visibility="Collapsed"
                                                     Icon="History"
                                                     Title="Aktivlik qeydi yoxdur"
                                                     Message="Bu vəsait üçün göstəriləcək tarixçə məlumatı yoxdur."/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Maliyyə və Texniki Xidmət">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Maliyyə Məlumatı" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                            <Border BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Alış Qiyməti:" FontWeight="SemiBold" Margin="0,0,10,10" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="PurchaseCostValue" Grid.Row="0" Grid.Column="1" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Təchizatçı:" FontWeight="SemiBold" Margin="0,0,10,10" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="SupplierValue" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Zəmanət Müddəti:" FontWeight="SemiBold" Margin="0,0,10,10" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="WarrantyValue" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="İstifadə müddəti:" FontWeight="SemiBold" Margin="0,10,10,10" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="UsefulLifeValue" Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="İllik Amortizasiya:" FontWeight="SemiBold" Margin="0,0,10,10" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="AnnualDepreciationValue" Grid.Row="4" Grid.Column="1" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Cari Dəyər:" FontWeight="SemiBold" Margin="0,0,10,10" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="CurrentValueValue" Grid.Row="5" Grid.Column="1" FontWeight="Bold" VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                            <Grid Margin="0,20,0,10">
                                <TextBlock Text="Texniki Xidmət Tarixçəsi" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                <Button x:Name="AddMaintenanceButton" Content="Qeyd Əlavə et" HorizontalAlignment="Right" Click="AddMaintenanceButton_Click"/>
                            </Grid>
                            <ListView x:Name="MaintenanceListView" BorderThickness="1" BorderBrush="{StaticResource ControlBorderBrush}" MaxHeight="400"
          MouseDoubleClick="MaintenanceListView_MouseDoubleClick">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Tarix" Width="120" DisplayMemberBinding="{Binding MaintenanceDate, StringFormat='yyyy-MM-dd'}"/>
                                        <GridViewColumn Header="Növ" Width="100" DisplayMemberBinding="{Binding MaintenanceType}"/>
                                        <GridViewColumn Header="Xərc" Width="80" DisplayMemberBinding="{Binding Cost, StringFormat=C}"/>
                                        <GridViewColumn Header="Təsvir" Width="200" DisplayMemberBinding="{Binding Description}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <local:EmptyStateControl x:Name="MaintenanceEmptyState"
                                                     Visibility="Collapsed"
                                                     Icon="History"
                                                     Title="Texniki xidmət qeydi yoxdur"
                                                     Message="Bu vəsait üçün hələ texniki xidmət qeydi əlavə edilməyib."
                                                     ActionText="Qeyd əlavə et"
                                                     ActionClick="AddMaintenanceButton_Click"
                                                     Margin="0,8,0,0"/>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</UserControl>