<Window x:Class="LoginAppFramework.HistoryLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginAppFramework"
        mc:Ignorable="d"
        Title="Tarixçə Jurnalı"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MainScreenWindowStyle}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="PageButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="MinWidth" Value="30"/>
        </Style>
        <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="0,0,0,1" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MenuButton" Style="{StaticResource PrimaryActionButton}" Height="40" Padding="15,0" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <local:AppIcon Icon="Menu" Size="18" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Menyu" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="1" Text="Tarixçə" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceMutedBrush}"

            <local:ConnectionStatusBannerControl DockPanel.Dock="Top"/>
 BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="0,0,0,1" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CountTextBlock" Grid.Column="0" Text="{Binding CountText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource BodyTextBrush}" Margin="0,0,20,0"/>

                    <!-- THE FIX: Updated the style of the filter controls -->
                    <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="Axtarış..." VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0,0,0">
                        <ComboBox x:Name="ActionFilterComboBox" Width="200"
                                  ItemsSource="{Binding ActionTypes}"
                                  SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Button x:Name="ClearFiltersButton" Content="Filtrləri təmizlə" Click="ClearFiltersButton_Click" Margin="20,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ✅ RESTORE ACTION BAR (visible only when deleted items are selected) -->
            <Border x:Name="RestoreActionBar"
                    DockPanel.Dock="Top"
                    Visibility="{Binding HasRestorableItems, Converter={StaticResource BoolToVis}}"
                    Background="{StaticResource MenuBackgroundBrush}"
                    BorderBrush="{StaticResource PrimaryBrushHover}"
                    BorderThickness="0,0,0,2"
                    Padding="15,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="SelectAllDeletedCheckBox"
                                  Content="Hamısını seç"
                                  Foreground="White" FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Checked="SelectAllDeletedCheckBox_Checked"
                                  Unchecked="SelectAllDeletedCheckBox_Unchecked"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Background="{StaticResource PrimaryBrush}" CornerRadius="12" Padding="10,4" Margin="0,0,10,0">
                            <TextBlock x:Name="SelectedCountBadge"
                                       Text="{Binding SelectedRestoreCountText}"
                                       Foreground="White" FontWeight="Bold" FontSize="13"/>
                        </Border>
                        <TextBlock Text="'Silinən' vəsaitlər bərpa ediləcək"
                                   Foreground="{StaticResource MenuSuccessTextBrush}" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                    <Button x:Name="RestoreSelectedButton"
                            Grid.Column="2"
                            Click="RestoreSelectedButton_Click"
                            IsEnabled="{Binding CanRestoreSelected}"
                            Padding="20,8">
                        <StackPanel Orientation="Horizontal">
                            <local:AppIcon Icon="Filter" Size="17" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Seçilənləri Bərpa Et" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="20" Style="{StaticResource SurfaceCardStyle}" Padding="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Padding="10" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PageInfoTextBlock" Grid.Column="0" Text="{Binding PageInfo}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="PrevButton" Content="&lt;&lt;" Style="{StaticResource PageButtonStyle}" Click="PrevButton_Click" IsEnabled="{Binding CanGoPrevious}"/>
                                    <StackPanel x:Name="PageNumbersPanel" Orientation="Horizontal"/>
                                    <Button x:Name="NextButton" Content="&gt;&gt;" Style="{StaticResource PageButtonStyle}" Click="NextButton_Click" IsEnabled="{Binding CanGoNext}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid>
                            <ListView x:Name="HistoryListView" ItemsSource="{Binding PagedEntries}" 
                                      MouseDoubleClick="HistoryListView_MouseDoubleClick"
                                      HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent"
                                      AlternationCount="2">
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:HistoryLogViewModel}">
                                        <Border BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="0,0,0,1" Padding="10,12" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- Checkbox column (only for Silinən) -->
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Checkbox — only visible for deleted rows -->
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Visibility="{Binding CanRestore, Converter={StaticResource BoolToVis}}"
                                                          VerticalAlignment="Center"/>

                                                <local:AppIcon Grid.Column="1"
                                                               Icon="{Binding Icon}"
                                                               Size="24"
                                                               VerticalAlignment="Center"
                                                               Margin="5,0,20,0"/>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding Description}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource BodyTextBrush}"
                                                               FontSize="14"/>

                                                    <ItemsControl ItemsSource="{Binding Changes}"
                                                                  Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}}"
                                                                  Margin="0,9,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type local:AuditDiffItem}">
                                                                <Grid Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="155"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="30"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Text="{Binding Field}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource SubtleTextBrush}"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,10,0"/>

                                                                    <Border Grid.Column="1"
                                                                            Background="{StaticResource DangerSurfaceBrush}"
                                                                            BorderBrush="{StaticResource DangerBorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="7"
                                                                            Padding="8,4">
                                                                        <TextBlock Text="{Binding OldValue}"
                                                                                   FontSize="11"
                                                                                   Foreground="{StaticResource DangerTextBrush}"
                                                                                   TextWrapping="Wrap"/>
                                                                    </Border>

                                                                    <TextBlock Grid.Column="2"
                                                                               Text="→"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               FontWeight="Bold"
                                                                               Foreground="{StaticResource SubtleTextBrush}"/>

                                                                    <Border Grid.Column="3"
                                                                            Background="{StaticResource SuccessSurfaceBrush}"
                                                                            BorderBrush="{StaticResource SuccessBorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="7"
                                                                            Padding="8,4">
                                                                        <TextBlock Text="{Binding NewValue}"
                                                                                   FontSize="11"
                                                                                   Foreground="{StaticResource SuccessTextBrush}"
                                                                                   TextWrapping="Wrap"/>
                                                                    </Border>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="20,0,5,0" TextBlock.TextAlignment="Right">
                                                    <TextBlock Foreground="{StaticResource BodyTextBrush}"><Run Text="tərəfindən: "/><Run Text="{Binding ChangedBy}"/></TextBlock>
                                                    <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <local:EmptyStateControl Icon="History"
                                                     Title="Tarixçə qeydi tapılmadı"
                                                     Message="Axtarış, əməliyyat növü və ya tarix filtrini dəyişərək yenidən yoxlayın."
                                                     ActionText="Filtrləri təmizlə"
                                                     ActionClick="ClearFiltersButton_Click">
                                <local:EmptyStateControl.Style>
                                    <Style TargetType="{x:Type local:EmptyStateControl}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasResults}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </local:EmptyStateControl.Style>
                            </local:EmptyStateControl>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SurfaceCardStyle}" Padding="16" Margin="0,20,20,20">
                    <StackPanel>
                        <TextBlock Text="Tarixə görə filtr" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,10"/>
                        <Calendar x:Name="DateFilterCalendar" SelectedDate="{Binding SelectedDate, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
        <local:MainNavigationMenu x:Name="SharedNavigationMenu" CurrentPage="History"/>
        <Border x:Name="LoadingOverlay"
                Background="{StaticResource GlassBackgroundBrush}"
                Visibility="Collapsed">
            <local:LoadingSkeletonControl/>
        </Border>
    </Grid>
</Window>