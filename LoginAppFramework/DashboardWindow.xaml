<Window x:Class="LoginAppFramework.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginAppFramework"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Title="İdarə Paneli"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MainScreenWindowStyle}">

    <Window.Resources>
        <Style x:Key="KpiPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}"/>
            <Setter Property="Effect" Value="{StaticResource SoftDropShadow}"/>
        </Style>

        <Style x:Key="ChartPanelStyle" TargetType="Border" BasedOn="{StaticResource SurfaceCardStyle}">
            <Setter Property="Padding" Value="22"/>
        </Style>

        <Style x:Key="ChartTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="ClickableKpiRowStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="0,0,0,1" Padding="16,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.04" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MenuButton" Style="{StaticResource PrimaryActionButton}" Height="40" Padding="15,0" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <local:AppIcon Icon="Menu" Size="18" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Menyu" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="İnventar İdarə Paneli" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock Text="Vəsait bölgüsü və maliyyə xülasəsi" HorizontalAlignment="Center" Foreground="{StaticResource BodyTextBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="Dövr:"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   Margin="0,0,8,0"/>
                        <ComboBox x:Name="DashboardPeriodComboBox"
                                  Width="130"
                                  SelectedIndex="0"
                                  SelectionChanged="DashboardPeriodComboBox_SelectionChanged">
                            <ComboBoxItem Content="Hamısı" Tag="All"/>
                            <ComboBoxItem Content="Bu il" Tag="Year"/>
                            <ComboBoxItem Content="Bu ay" Tag="Month"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top"
                    Background="{StaticResource SurfaceMutedBrush}"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="WarrantyAlertButton"
                                Padding="10,6"
                                Margin="0,0,8,0"
                                Click="WarrantyAlertButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <local:AppIcon Icon="Warning"
                                               Size="16"
                                               Foreground="{StaticResource WarningTextBrush}"/>
                                <TextBlock x:Name="WarrantyAlertCountText"
                                           Margin="7,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MaintenanceAlertButton"
                                Padding="10,6"
                                Margin="0,0,8,0"
                                Click="MaintenanceAlertButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <local:AppIcon Icon="Maintenance"
                                               Size="16"
                                               Foreground="{StaticResource WarningTextBrush}"/>
                                <TextBlock x:Name="MaintenanceAlertCountText"
                                           Margin="7,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Padding="10,6"
                                Click="NotificationCenterButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <local:AppIcon Icon="Notification"
                                               Size="16"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock x:Name="NotificationUnreadCountText"
                                           Margin="7,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock x:Name="DashboardPeriodSummaryText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SubtleTextBrush}"/>
                </Grid>
            </Border>

            <Grid x:Name="DashboardLayoutGrid"
                  Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="DashboardTopRow" Height="*"/>
                    <RowDefinition x:Name="DashboardBottomRow" Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DashboardChartsColumn" Width="3.5*" />
                    <ColumnDefinition x:Name="DashboardKpiColumn" Width="1*" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="ChartsGrid"
                      Grid.Column="0"
                      Grid.RowSpan="2"
                      Margin="0,0,15,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="DepartmentsChartCard"
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource ChartPanelStyle}"
                            Margin="0,0,7.5,7.5">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Style="{StaticResource ChartTitleStyle}" Text="Departamentlər Üzrə Vəsaitlər"/>
                                <TextBlock Text="Detala baxmaq üçün sütuna klikləyin"
                                           FontSize="11"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="0,-10,0,8"/>
                            </StackPanel>
                            <lvc:CartesianChart Series="{Binding DepartmentsSeries, Mode=OneWay}"
                                                LegendLocation="None"
                                                DataClick="DepartmentsChart_DataClick"
                                                Cursor="Hand"
                                                ToolTip="Departament üzrə vəsaitləri görmək üçün sütuna klikləyin.">
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Labels="{Binding DepartmentsLabels, Mode=OneWay}" Margin="0,0,15,0" 
                                              FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BodyTextBrush}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="False" Step="1" />
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="Sayı" LabelFormatter="{Binding Value, StringFormat={}{0:N0}}" Margin="0,5,0,0"
                                              FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BodyTextBrush}"/>
                                </lvc:CartesianChart.AxisX>
                            </lvc:CartesianChart>
                        </DockPanel>
                    </Border>

                    <Border x:Name="CategoryChartCard"
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource ChartPanelStyle}"
                            Margin="7.5,0,0,7.5">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Style="{StaticResource ChartTitleStyle}" Text="Vəsaitlər Kateqoriya Üzrə"/>
                                <TextBlock Text="Detala baxmaq üçün diaqram hissəsinə klikləyin"
                                           FontSize="11"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="0,-10,0,8"/>
                            </StackPanel>
                            <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding LegendItems}" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="10,5" 
                                                    ToolTip="{Binding ToolTipText}"
                                                    MouseLeftButtonDown="LegendItem_MouseLeftButtonDown"
                                                    Cursor="Hand">
                                            <Ellipse Width="12" Height="12" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CategoryName}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <lvc:PieChart Series="{Binding CategorySeries, Mode=OneWay}"
                                              LegendLocation="None"
                                              DataClick="PieChart_DataClick"
                                              Cursor="Hand"
                                              ToolTip="Kateqoriya üzrə vəsaitləri görmək üçün diaqram hissəsinə klikləyin." />
                        </DockPanel>
                    </Border>

                    <Border x:Name="TopAssetsChartCard"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource ChartPanelStyle}"
                            Margin="0,7.5,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Style="{StaticResource ChartTitleStyle}" Text="Şirkətdə Ən Çox Alınan Vəsaitlər (Top 10)"/>
                                <TextBlock Text="Detala baxmaq üçün sütuna klikləyin"
                                           FontSize="11"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="0,-10,0,8"/>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <lvc:CartesianChart x:Name="TopAssetsChart"
                                                    Series="{Binding TopAssetsSeries, Mode=OneWay}"
                                                    DataClick="TopAssetsChart_DataClick"
                                                    Hoverable="True"
                                                    DisableAnimations="True"
                                                    DataTooltip="{Binding TopAssetsTooltip, Mode=OneWay}"
                                                    LegendLocation="None"
                                                    Cursor="Hand"
                                                    ToolTip="Vəsait üzrə detalları görmək üçün sütuna klikləyin.">
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Labels="{Binding TopAssetsLabels, Mode=OneWay}" 
                                                  ShowLabels="True" 
                                                  LabelsRotation="0"
                                                  FontWeight="SemiBold"
                                                  Foreground="{StaticResource BodyTextBrush}"
                                                  FontSize="12">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator Step="1" IsEnabled="False"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis Title="Sayı" 
                                                  MinValue="0"
                                                  FontSize="12"
                                                  FontWeight="SemiBold"
                                                  Foreground="#666"
                                                  Margin="0,0,10,0"/>
                                        <lvc:Axis Title="Ortalama Qiymət" 
                                                  Position="RightTop" 
                                                  LabelFormatter="{Binding Value, StringFormat=C0, ConverterCulture=az-AZ}" 
                                                  MinValue="0"
                                                  FontSize="12"
                                                  FontWeight="SemiBold"
                                                  Foreground="#666"/>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>

                                <lvc:DefaultLegend 
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,10,0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="KpiGrid"
                      Grid.Column="1"
                      Grid.RowSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1.5*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0"/>
                        <ColumnDefinition Width="0"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="TotalAssetsCard"
                            Grid.Row="0"
                            Style="{StaticResource KpiPanelStyle}"
                            Margin="0,0,0,7.5">
                        <Grid>
                            <local:AppIcon Icon="Assets" Size="48" Foreground="White" Opacity="0.5"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" IsHitTestVisible="False"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                <TextBlock Text="{Binding TotalAssets, StringFormat={}{0:N0}, Mode=OneWay}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Ümumi Aktiv Vəsaitlər" Foreground="White" Opacity="0.8"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="TotalPurchaseCard"
                            Grid.Row="1"
                            Style="{StaticResource KpiPanelStyle}"
                            Margin="0,7.5,0,7.5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" VerticalAlignment="Top">
                                <TextBlock Text="{Binding TotalPurchaseCost, Mode=OneWay}" FontSize="32" FontWeight="Bold" Foreground="White"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                <TextBlock Text="Ümumi Alış Dəyəri" Foreground="White" Opacity="0.8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,10,0,0">
                                <Border Height="1" Background="White" Opacity="0.2" Margin="0,0,0,10"/>

                                <Button x:Name="TangibleButton" Style="{StaticResource ClickableKpiRowStyle}" Command="{Binding OpenTangiblePopupCommand}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Maddi Aktiv" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TangibleAssetsCost}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                    </Grid>
                                </Button>

                                <Button x:Name="IntangibleButton" Style="{StaticResource ClickableKpiRowStyle}" Command="{Binding OpenIntangiblePopupCommand}" Margin="0,5,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Qeyri-Maddi Aktiv" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding IntangibleAssetsCost}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="CurrentValueCard"
                            Grid.Row="2"
                            Style="{StaticResource KpiPanelStyle}"
                            Margin="0,7.5,0,7.5">
                        <Grid>
                            <local:AppIcon Icon="Money" Size="48" Foreground="White" Opacity="0.5"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" IsHitTestVisible="False"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                <TextBlock Text="{Binding CurrentValue, Mode=OneWay}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Cari Dəyər" Foreground="White" Opacity="0.8"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="DepreciationCard"
                            Grid.Row="3"
                            Style="{StaticResource KpiPanelStyle}"
                            Margin="0,7.5,0,0">
                        <Grid>
                            <local:AppIcon Icon="Depreciation" Size="48" Foreground="White" Opacity="0.5"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" IsHitTestVisible="False"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                <TextBlock Text="{Binding AnnualDepreciation, Mode=OneWay}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="İllik Amortizasiya" Foreground="White" Opacity="0.8"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>

        <Popup IsOpen="{Binding IsTangiblePopupOpen}"
               PlacementTarget="{Binding ElementName=TangibleButton}"
               Placement="Right" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="5"
                    BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                    Padding="15" Margin="10,0,0,0" MinWidth="350" MaxHeight="300">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.2"/>
                </Border.Effect>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Kateqoriya" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="Alış Dəyəri" FontWeight="Bold" Margin="0,0,15,0"/>
                        <TextBlock Grid.Column="2" Text="Cari Dəyər" FontWeight="Bold"/>
                    </Grid>
                    <Separator DockPanel.Dock="Top" Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TangibleCategoryCosts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="100"/>
                                            <ColumnDefinition Width="Auto" MinWidth="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding CategoryName}" Margin="0,0,15,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FormattedPurchaseCost}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Text="{Binding FormattedCurrentValue}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>

        <Popup IsOpen="{Binding IsIntangiblePopupOpen}"
               PlacementTarget="{Binding ElementName=IntangibleButton}"
               Placement="Right" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="5"
                    BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                    Padding="15" Margin="10,0,0,0" MinWidth="350" MaxHeight="300">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.2"/>
                </Border.Effect>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Kateqoriya" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="Alış Dəyəri" FontWeight="Bold" Margin="0,0,15,0"/>
                        <TextBlock Grid.Column="2" Text="Cari Dəyər" FontWeight="Bold"/>
                    </Grid>
                    <Separator DockPanel.Dock="Top" Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding IntangibleCategoryCosts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="100"/>
                                            <ColumnDefinition Width="Auto" MinWidth="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding CategoryName}" Margin="0,0,15,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FormattedPurchaseCost}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Text="{Binding FormattedCurrentValue}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>

        <local:MainNavigationMenu x:Name="SharedNavigationMenu" CurrentPage="Dashboard"/>
        <Border x:Name="LoadingOverlay"
                Background="{StaticResource GlassBackgroundBrush}"
                Visibility="Collapsed">
            <local:LoadingSkeletonControl/>
        </Border>
    </Grid>
</Window>