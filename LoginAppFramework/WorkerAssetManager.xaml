<UserControl x:Class="LoginAppFramework.WorkerAssetManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LoginAppFramework"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="650"
             Background="{StaticResource PanelBackgroundBrush}">
    <Grid>
        <TextBlock x:Name="SelectWorkerPrompt" Text="Məlumatları görmək üçün siyahıdan bir işçi seçin."
                   FontSize="18" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center" 
                   VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>

        <Grid x:Name="DetailViewPanel" Visibility="Collapsed" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <Button x:Name="CloseDetailPanelButton"
                        DockPanel.Dock="Top"
                        HorizontalAlignment="Right"
                        Click="CloseDetailPanelButton_Click"
                        ToolTip="Detallı Görünüşü Bağla"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource BodyTextBrush}"
                        Width="32"
                        Height="32"
                        Margin="0,-10,-10,-5">
                    <local:AppIcon Icon="Close" Size="17"/>
                </Button>

                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <local:AppIcon Grid.Column="0" Icon="User" Size="48" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name, Mode=OneWay, TargetNullValue='İşçi seçin'}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Position, Mode=OneWay}" FontSize="16" Foreground="{StaticResource BodyTextBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="10" Padding="15" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" Margin="0,0,0,15">
                    <Grid TextElement.Foreground="{StaticResource BodyTextBrush}" TextElement.FontWeight="SemiBold">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalPurchaseCost, Mode=OneWay, TargetNullValue='₼0.00'}" FontSize="18" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Cəmi Alış Dəyəri" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalDepreciation, Mode=OneWay, TargetNullValue='₼0.00'}" FontSize="18" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Cəmi Amortizasiya" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalAssetValue, Mode=OneWay, TargetNullValue='₼0.00'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Cari Vəsait Dəyəri" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock DockPanel.Dock="Top" Margin="0,5,0,10">
                    <Run Text="Təhkim Olunmuş Vəsaitlər" FontWeight="SemiBold" FontSize="14"/>
                    <Run Text="(" FontWeight="Normal" Foreground="{StaticResource SubtleTextBrush}"/><Run Text="{Binding AssignedAssetsCount, Mode=OneWay}" FontWeight="Normal" Foreground="{StaticResource SubtleTextBrush}"/><Run Text=")" FontWeight="Normal" Foreground="{StaticResource SubtleTextBrush}"/>
                </TextBlock>

                <DataGrid x:Name="AssignedAssetsDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          AlternationCount="2"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          MouseDoubleClick="AssignedAssetsDataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Vesaitin Kodu" Binding="{Binding VesaitinKodu}" Width="1.5*"/>
                        <DataGridTextColumn Header="Vesaitin Adı" Binding="{Binding VesaitinAdi}" Width="2*"/>
                        <DataGridTextColumn Header="Kateqoriya" Binding="{Binding Kateqoriya}" Width="1.5*"/>
                        <DataGridTextColumn Header="Alış Dəyəri" Binding="{Binding PurchaseCost, StringFormat=C, ConverterCulture=az-AZ}" Width="1*"/>
                        <DataGridTextColumn Header="Cari Dəyər" Binding="{Binding CurrentValue, StringFormat=C, ConverterCulture=az-AZ}" Width="1*"/>
                        <DataGridTemplateColumn Header="Əməliyyatlar" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Ləğv et"
                                            FontSize="10" Padding="5,2"
                                            Style="{StaticResource WarningActionButton}"
                                            Click="UnassignButton_Click"
                                            IsEnabled="{Binding DataContext.CanEditAssets, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

            </DockPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button x:Name="EditWorkerButton"
                        Content="İşçini Redaktə et"
                        Click="EditWorkerButton_Click"
                        Style="{StaticResource PrimaryActionButton}"
                        Margin="0,0,10,0"/>
                <Button x:Name="DeleteWorkerButton"
                        Content="İşçini Sil"
                        Click="DeleteWorkerButton_Click"
                        Style="{StaticResource DangerActionButton}"
                        Margin="0,0,10,0"/>
                <Button x:Name="AssignNewAssetButton"
                        Content="Bu İşçiyə Yeni Vəsait Təhkim et..."
                        Click="AssignNewAssetButton_Click"
                        Style="{StaticResource PrimaryActionButton}"/>
            </StackPanel>

        </Grid>
    </Grid>
</UserControl>