<Window x:Class="LoginAppFramework.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daxil Ol" Height="Auto" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Loaded="Window_Loaded"
        FontFamily="Segoe UI"
        Background="{StaticResource AppBackgroundBrush}">
    <Border Background="{StaticResource PanelBackgroundBrush}" Padding="42,36" Width="410" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" Color="#000000" Opacity="0.08" BlurRadius="28"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="İnventar Sistemi" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}"/>
            <TextBlock x:Name="SubtitleText" Text="Davam etmək üçün daxil olun" FontSize="15" Foreground="{StaticResource BodyTextBrush}" HorizontalAlignment="Center" Margin="0,6,0,24"/>
            <TextBlock x:Name="ErrorMessage" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
            <StackPanel x:Name="SetupView">
                <TextBlock Text="SQL Server Ünvanı" FontWeight="SemiBold" Foreground="{StaticResource BodyTextBrush}" Margin="0,10,0,5"/>
                <TextBox x:Name="ServerBox"/>
                <TextBlock Text="SQL İstifadəçi Adı" FontWeight="SemiBold" Foreground="{StaticResource BodyTextBrush}" Margin="0,15,0,5"/>
                <TextBox x:Name="SqlUsernameBox"/>
                <TextBlock Text="SQL Şifrəsi" FontWeight="SemiBold" Foreground="{StaticResource BodyTextBrush}" Margin="0,15,0,5"/>
                <PasswordBox x:Name="SqlPasswordBox" KeyDown="SqlPasswordBox_KeyDown"/>
                <Button x:Name="TestAndSaveButton" Content="Yoxla və Yadda Saxla" Style="{StaticResource PrimaryActionButton}" Margin="0,30,0,0" Click="TestAndSave_Click"/>
            </StackPanel>
            <StackPanel x:Name="LoginView">
                <TextBlock Text="İstifadəçi adı" FontWeight="SemiBold" Foreground="{StaticResource BodyTextBrush}" Margin="0,10,0,5"/>
                <TextBox x:Name="UsernameBox"/>
                <TextBlock Text="Şifrə" FontWeight="SemiBold" Foreground="{StaticResource BodyTextBrush}" Margin="0,15,0,5"/>
                <PasswordBox x:Name="PasswordBox" KeyDown="PasswordBox_KeyDown"/>
                <Button x:Name="LoginButton" Content="Daxil Ol" Style="{StaticResource PrimaryActionButton}" Margin="0,30,0,0" Click="Login_Click"/>
                <Button Content="Server Ayarlarını Dəyiş" HorizontalAlignment="Center" Margin="0,20,0,0" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" Click="ChangeServerSettings_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>