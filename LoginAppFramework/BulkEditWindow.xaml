<Window x:Class="LoginAppFramework.BulkEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LoginAppFramework"
        Title="Toplu Vəsait Dəyişikliyi"
        Width="620"
        Height="720"
        MinWidth="520"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="InstructionText"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   Margin="0,0,0,15"
                   Text="Seçilmiş bütün vəsaitlər üçün dəyişdirmək istədiyiniz sahələrə YENİ dəyər daxil edin. Sahələri boş buraxmaq onların orijinal dəyərlərini saxlayacaq."/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Yeni Vəsaitin Kodu:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
                <TextBox x:Name="VesaitinKoduTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Padding="5"/>

                <Label Grid.Row="1" Content="Yeni Vəsaitin Adı:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
                <TextBox x:Name="VesaitinAdiTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Padding="5"/>

                <Label Grid.Row="2" Content="Yeni Seriya Nömrəsi:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
                <TextBox x:Name="SeriyaNomresiTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Padding="5"/>

                <Label Grid.Row="3" Content="Yeni Kateqoriya:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
                <ComboBox x:Name="CategoryComboBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Padding="5"/>

                <Label Grid.Row="4" Content="Yeni Təhkim Olunan Əməkdaş:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
                <ComboBox x:Name="UserComboBox"
                          Grid.Row="4"
                          Grid.Column="1"
                          DisplayMemberPath="DisplayName"
                          TextSearch.TextPath="DisplayName"
                          Margin="0,0,0,10"
                          Padding="5"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          StaysOpenOnEdit="True"
                          LostKeyboardFocus="UserComboBox_LostKeyboardFocus"/>

                <Label Grid.Row="5" Content="Bölmə/Şöbə əməkdaşdan avtomatik müəyyən edilir" Visibility="Collapsed"/>
                <ComboBox x:Name="DepartmentComboBox" Grid.Row="5" Grid.Column="1" Visibility="Collapsed"/>

                <Label Grid.Row="6" Content="Yeni Yerləşmə Yeri:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
                <TextBox x:Name="LocationTextBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,10" Padding="5"/>

                <Label Grid.Row="7" Content="Yeni Ərazi:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
                <TextBox x:Name="AreaTextBox" Grid.Row="7" Grid.Column="1" Margin="0,0,0,10" Padding="5"/>

                <Label Grid.Row="8" Content="Yeni Status:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
                <ComboBox x:Name="StatusComboBox" Grid.Row="8" Grid.Column="1" Margin="0,0,0,10" Padding="5"/>

                <Separator Grid.Row="9" Grid.ColumnSpan="2" Margin="0,5,0,10"/>

                <Label Grid.Row="10" Content="Yeni Alış Qiyməti:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox x:Name="PurchaseCostTextBox" Grid.Row="10" Grid.Column="1" Margin="0,0,0,10" Padding="5"/>

                <Label Grid.Row="11" Content="Yeni Alınma Tarixi:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <local:DateSelectorControl x:Name="PurchaseDateSelector"
                                           Grid.Row="11"
                                           Grid.Column="1"
                                           Margin="0,0,0,10"
                                           AllowClear="True"
                                           DialogTitle="Yeni alınma tarixini seçin"/>

                <Label Grid.Row="12" Content="Yeni Təchizatçı:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox x:Name="SupplierTextBox" Grid.Row="12" Grid.Column="1" Margin="0,0,0,10" Padding="5"/>

                <Label Grid.Row="13" Content="Yeni Zəmanət Müddəti:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <local:DateSelectorControl x:Name="WarrantyDateSelector"
                                           Grid.Row="13"
                                           Grid.Column="1"
                                           Margin="0,0,0,10"
                                           AllowClear="True"
                                           DialogTitle="Yeni zəmanət bitmə tarixini seçin"/>

                <Label Grid.Row="14" Content="Yeni İstifadə müddəti (İl):" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox x:Name="UsefulLifeTextBox" Grid.Row="14" Grid.Column="1" Margin="0,0,0,10" Padding="5"/>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="{StaticResource ControlBorderBrush}"
                BorderThickness="0,1,0,0"
                Margin="0,12,0,0"
                Padding="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Yadda Saxla"
                        Width="110"
                        Margin="0,0,10,0"
                        Style="{StaticResource PrimaryActionButton}"
                        IsDefault="True"
                        Click="ApplyButton_Click"/>
                <Button Content="Ləğv et"
                        Width="90"
                        IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>