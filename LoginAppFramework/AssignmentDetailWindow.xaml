<Window x:Class="LoginAppFramework.AssignmentDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assignment Event Details" Height="Auto" Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow" ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI">
    <Border Padding="20">
        <StackPanel>
            <TextBlock x:Name="EventTitleTextBlock" Text="Asset Assigned" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,5"/>
            <TextBlock x:Name="EventSubtitleTextBlock" Text="by Admin User on 2023-10-27" FontSize="14" Foreground="{StaticResource BodyTextBrush}" Margin="0,0,0,20"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="4" Padding="15" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Asset Details" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock x:Name="AssetNameTextBlock" Text="LAPTOP-001"/>
                        <TextBlock x:Name="AssetCategoryTextBlock" Text="Laptop" Foreground="#555"/>
                        <TextBlock x:Name="AssetSerialTextBlock" Text="SN: XXXXXXXX" Foreground="#555" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="4" Padding="15" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="User Details" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock x:Name="UserNameTextBlock" Text="John Smith"/>
                        <TextBlock x:Name="UserPositionTextBlock" Text="Lead Developer" Foreground="#555"/>
                        <TextBlock x:Name="UserDepartmentTextBlock" Text="Department: Technology" Foreground="#555" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Margin="0,20,0,0" Background="{StaticResource PrimaryBrush}" Foreground="{StaticResource PrimaryForegroundBrush}"/>
        </StackPanel>
    </Border>
</Window>