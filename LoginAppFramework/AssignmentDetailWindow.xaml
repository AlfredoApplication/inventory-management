<Window x:Class="LoginAppFramework.AssignmentDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Təhkimat Detalları" Height="Auto" Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow" ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI">
    <Border Style="{StaticResource SurfaceCardStyle}" Margin="24" Padding="24">
        <StackPanel>
            <TextBlock x:Name="EventTitleTextBlock" Text="Vəsait təhkim edildi" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,5"/>
            <TextBlock x:Name="EventSubtitleTextBlock" Text="Admin tərəfindən • 2023-10-27" FontSize="14" Foreground="{StaticResource BodyTextBrush}" Margin="0,0,0,20"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="10" Padding="15" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Vəsait məlumatları" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock x:Name="AssetNameTextBlock" Text="LAPTOP-001"/>
                        <TextBlock x:Name="AssetCategoryTextBlock" Text="Laptop" Foreground="{StaticResource SubtleTextBrush}"/>
                        <TextBlock x:Name="AssetSerialTextBlock" Text="SN: XXXXXXXX" Foreground="{StaticResource SubtleTextBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="10" Padding="15" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="İşçi məlumatları" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock x:Name="UserNameTextBlock" Text="İstifadəçi"/>
                        <TextBlock x:Name="UserPositionTextBlock" Text="Lead Developer" Foreground="{StaticResource SubtleTextBrush}"/>
                        <TextBlock x:Name="UserDepartmentTextBlock" Text="Department: Technology" Foreground="{StaticResource SubtleTextBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Margin="0,20,0,0" Style="{StaticResource PrimaryActionButton}"/>
        </StackPanel>
    </Border>
</Window>