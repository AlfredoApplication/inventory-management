<UserControl x:Class="LoginAppFramework.ToastNotificationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             d:DesignHeight="80" d:DesignWidth="350"
             Visibility="Collapsed" Opacity="0">
    <Border x:Name="ToastBorder" Background="#2ECC71" CornerRadius="5" Margin="20" MinHeight="60">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="2" BlurRadius="15" Opacity="0.25" Color="Black"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,10">
            <TextBlock x:Name="IconText" Text="✅" FontSize="24" VerticalAlignment="Center" Foreground="White"/>
            <TextBlock x:Name="MessageText" Text="Action was successful." VerticalAlignment="Center" Margin="15,0,0,0" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>