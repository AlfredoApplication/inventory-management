<Window x:Class="LoginAppFramework.SelectAssetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mövcud Vəsaiti Seçin" 
        Height="600" Width="750"
        WindowStartupLocation="CenterOwner" 
        Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{StaticResource RowAlternateBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Mövcud Vəsaiti Seçin" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}"/>
            <TextBox x:Name="SearchBox" Grid.Column="1" Width="250" TextChanged="SearchBox_TextChanged" VerticalAlignment="Center" ToolTip="Kod, Ad və ya Kateqoriya üzrə axtarış..."/>
        </Grid>
        <ListView x:Name="AvailableAssetsListView" Grid.Row="1" Margin="0,0,0,15" MouseDoubleClick="AvailableAssetsListView_MouseDoubleClick" AlternationCount="2">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Vesaitin Kodu" Width="200" DisplayMemberBinding="{Binding VesaitinKodu}"/>
                    <GridViewColumn Header="Vesaitin Adı" Width="250" DisplayMemberBinding="{Binding VesaitinAdi}"/>
                    <GridViewColumn Header="Kateqoriya" Width="200" DisplayMemberBinding="{Binding Kateqoriya}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Seç" Width="90" IsDefault="True" Style="{StaticResource PrimaryActionButton}" Margin="0,0,10,0" Click="SelectButton_Click"/>
            <Button Content="Ləğv et" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>