<Window x:Class="LoginAppFramework.SelectAssetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LoginAppFramework"
        Title="Mövcud Vəsaiti Seçin" 
        Height="600" Width="750"
        WindowStartupLocation="CenterOwner" 
        Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{StaticResource RowAlternateBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Style="{StaticResource SurfaceCardStyle}" Margin="20" Padding="18">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Mövcud Vəsaiti Seçin" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}"/>
            <TextBox x:Name="SearchBox" Grid.Column="1" Width="250" TextChanged="SearchBox_TextChanged" VerticalAlignment="Center" Tag="Axtarış..." ToolTip="Kod, ad və ya kateqoriya üzrə axtarış..."/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <ListView x:Name="AvailableAssetsListView" MouseDoubleClick="AvailableAssetsListView_MouseDoubleClick" AlternationCount="2">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Vesaitin Kodu" Width="200" DisplayMemberBinding="{Binding VesaitinKodu}"/>
                        <GridViewColumn Header="Vesaitin Adı" Width="250" DisplayMemberBinding="{Binding VesaitinAdi}"/>
                        <GridViewColumn Header="Kateqoriya" Width="200" DisplayMemberBinding="{Binding Kateqoriya}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <local:EmptyStateControl x:Name="EmptyState"
                                     Visibility="Collapsed"
                                     Icon="Assets"
                                     Title="Uyğun vəsait tapılmadı"
                                     Message="Axtarış sözünü dəyişərək yenidən yoxlayın."/>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Seç" Width="90" IsDefault="True" Style="{StaticResource PrimaryActionButton}" Margin="0,0,10,0" Click="SelectButton_Click"/>
            <Button Content="Ləğv et" Width="90" IsCancel="True"/>
        </StackPanel>
        </Grid>
    </Border>
</Window>