<UserControl x:Class="LoginAppFramework.DateSelectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LoginAppFramework">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="42"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBox x:Name="DateTextBox"
                 Grid.Column="0"
                 Height="40"
                 IsReadOnly="True"
                 IsTabStop="False"
                 VerticalContentAlignment="Center"
                 Padding="10,0"
                 Background="White"
                 BorderBrush="{StaticResource ControlBorderBrush}"
                 BorderThickness="1"/>

        <Button Grid.Column="1"
                Height="40"
                Margin="6,0,0,0"
                Padding="0"
                ToolTip="Tarix seç"
                Click="CalendarButton_Click">
            <local:AppIcon Icon="Calendar" Size="17"/>
        </Button>

        <Button x:Name="ClearButton"
                Grid.Column="2"
                Height="40"
                MinWidth="40"
                Margin="6,0,0,0"
                Padding="8,0"
                Foreground="{StaticResource SubtleTextBrush}"
                ToolTip="Tarixi təmizlə"
                Visibility="Collapsed"
                Click="ClearButton_Click">
            <local:AppIcon Icon="Close" Size="14"/>
        </Button>
    </Grid>
</UserControl>