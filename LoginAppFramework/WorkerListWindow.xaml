<Window x:Class="LoginAppFramework.WorkerListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginAppFramework"
        mc:Ignorable="d"
        Title="İşçi İdarəetməsi"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MainScreenWindowStyle}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{StaticResource RowAlternateBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowSelectedBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                    <Setter Property="ToolTip" Value="Bu işçi qeyri-aktivdir."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModernNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34495E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Storyboard x:Key="OpenMenu">
            <DoubleAnimation Storyboard.TargetName="SlideOutMenu" Storyboard.TargetProperty="Width" To="260" Duration="0:0:0.3"/>
        </Storyboard>
        <Storyboard x:Key="CloseMenu">
            <DoubleAnimation Storyboard.TargetName="SlideOutMenu" Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.3"/>
        </Storyboard>
        <Style x:Key="FilterHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,15,0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="0,0,0,1" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MenuButton" Style="{StaticResource PrimaryActionButton}" Height="40" Padding="15,0" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <local:AppIcon Icon="Menu" Size="18" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Menyu" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="1" Text="İşçi İdarəetməsi" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="FilterPanelToggleButton"
                                Content="Filtrləri Gizlət"
                                Click="ToggleFilterPanelButton_Click"
                                Margin="0,0,10,0"/>
                        <Button x:Name="SyncWorkersButton" Content="HR ilə Sinxronizasiya" Style="{StaticResource PrimaryActionButton}" Click="SyncWorkersButton_Click" Margin="0,0,10,0" ToolTip="İşçi siyahısını uzaq HR məlumat bazası ilə sinxronizasiya edin."/>
                        <Button x:Name="AddWorkerButton" Content="Yeni İşçi Əlavə et" Style="{StaticResource PrimaryActionButton}" Click="AddWorkerButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FilterColumn" Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="FilterSidebar" Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}" Padding="18,16" BorderThickness="0,0,1,0" BorderBrush="{StaticResource ControlBorderBrush}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Filtrlər" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="ClearFiltersButton" Content="Hamısını Təmizlə" Click="ClearFiltersButton_Click" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <StackPanel x:Name="FilterPanel" DataContext="{Binding Filters}">
                                <TextBlock Text="Status" Style="{StaticResource FilterHeader}" Margin="0,0,0,5"/>
                                <RadioButton x:Name="ActiveFilterButton" Content="Yalnız Aktiv" GroupName="StatusFilter"
                                             IsChecked="{Binding DataContext.IsActiveFilterSelected, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                                <RadioButton x:Name="InactiveFilterButton" Content="Yalnız Qeyri-Aktiv" GroupName="StatusFilter" Margin="0,5,0,0"
                                             IsChecked="{Binding DataContext.IsInactiveFilterSelected, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                                <RadioButton x:Name="AllFilterButton" Content="Bütün İşçilər" GroupName="StatusFilter" Margin="0,5,0,0"
                                             IsChecked="{Binding DataContext.IsAllFilterSelected, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                                <TextBlock Text="Ada görə Axtarış" Style="{StaticResource FilterHeader}"/>
                                <TextBox x:Name="SearchBox" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="Axtarış..."/>
                                <Expander Header="Departament" IsExpanded="True" Margin="0,15,0,0">
                                    <ItemsControl ItemsSource="{Binding DepartmentOptions}" Margin="10,5,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource SurfaceMutedBrush}" Padding="8,6" MinHeight="36">
                        <ItemsControl x:Name="ActiveFiltersPanel" ItemsSource="{Binding ActiveFilterTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource RowSelectedBrush}" CornerRadius="12" Margin="3" Padding="10,4">
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border Grid.Row="1" x:Name="SummaryPanel" DataContext="{Binding Filters}" Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="0,0,0,1"
                            Padding="20,14">
                        <UniformGrid Columns="4">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalPurchaseCost}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Cəmi Alış Dəyəri" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalDepreciation}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Cəmi Amortizasiya" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalMonthlyDepreciation}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Aylıq Amortizasiya" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalCurrentValue}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Cari Vəsait Dəyəri" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <Border Grid.Row="2" x:Name="BulkActionPanel" Background="{StaticResource SurfaceMutedBrush}" Padding="10,8" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="0,0,0,1"
                            Visibility="{Binding HasBulkSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SelectionCountText" Text="{Binding SelectionCountText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0,20,0" Foreground="{StaticResource BodyTextBrush}"/>
                            <Button x:Name="BulkDeactivateButton" Content="Seçilmişləri Deaktiv et" Click="BulkDeactivateButton_Click" Background="{StaticResource WarningBrush}" Foreground="{StaticResource PrimaryForegroundBrush}" Padding="8,4" Margin="0,0,10,0" ToolTip="Seçilmiş aktiv işçiləri qeyri-aktiv olaraq işarələyin."/>
                            <Button x:Name="BulkActivateButton" Content="Seçilmişləri Aktiv et" Click="BulkActivateButton_Click" Background="{StaticResource SuccessBrush}" Foreground="{StaticResource PrimaryForegroundBrush}" Padding="8,4" ToolTip="Seçilmiş qeyri-aktiv işçiləri aktiv olaraq işarələyin."/>
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Row="3" x:Name="WorkersDataGrid" ItemsSource="{Binding VisibleWorkers}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" AlternationCount="2" SelectionChanged="WorkersDataGrid_SelectionChanged" MouseDoubleClick="WorkersDataGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                             <DataGridTextColumn Header="Tam Ad" Binding="{Binding Name}" Width="2*"/>
                             <DataGridTextColumn Header="Vəzifə" Binding="{Binding Position}" Width="2.5*"/>
                             <DataGridTextColumn Header="Departament" Binding="{Binding Department}" Width="2*"/>
                             <DataGridTemplateColumn Header="Status" Width="120">
                                 <DataGridTemplateColumn.CellTemplate>
                                     <DataTemplate>
                                         <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                                             <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                                 <Ellipse.Style>
                                                     <Style TargetType="Ellipse">
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                 <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                 <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Ellipse.Style>
                                             </Ellipse>
                                             <TextBlock VerticalAlignment="Center">
                                                 <TextBlock.Style>
                                                     <Style TargetType="TextBlock">
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                 <Setter Property="Text" Value="Aktiv"/>
                                                                 <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                 <Setter Property="Text" Value="Qeyri-Aktiv"/>
                                                                 <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </TextBlock.Style>
                                             </TextBlock>
                                         </StackPanel>
                                     </DataTemplate>
                                 </DataGridTemplateColumn.CellTemplate>
                             </DataGridTemplateColumn>
                             <DataGridTextColumn Header="Vəsaitlər" Binding="{Binding AssignedAssetsCount}" Width="*"/>
                         </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="3"
                            x:Name="NoResultsPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="28,22">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResults}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <local:AppIcon Icon="Workers"
                                           Size="34"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,10"/>
                            <TextBlock Text="İşçi tapılmadı"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Axtarış və ya filtrləri dəyişərək yenidən yoxlayın."
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       Margin="0,5,0,14"
                                       HorizontalAlignment="Center"/>
                            <Button Content="Filtrləri təmizlə"
                                    HorizontalAlignment="Center"
                                    Click="ClearFiltersButton_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.RowSpan="4" x:Name="DetailPanelContainer" HorizontalAlignment="Right" Width="0" Background="{StaticResource PanelBackgroundBrush}" BorderThickness="1,0,0,0" BorderBrush="{StaticResource ControlBorderBrush}">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.1" Direction="-90"/>
                        </Border.Effect>
                        <local:WorkerAssetManager x:Name="WorkerAssetManager" AssetAssignmentChanged="AssetManager_AssetAssignmentChanged" OnEditWorker="Manager_EditWorker" OnDeleteWorker="Manager_DeleteWorker" OnDetailPanelClosed="DetailControl_PanelClosed"/>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
        <local:MainNavigationMenu x:Name="SharedNavigationMenu" CurrentPage="Workers"/>
        <Border x:Name="LoadingOverlay" Background="#AAFFFFFF" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="LoadingMessage" Text="İşçilər yüklənir..." FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Məlumatlar hazırlanır." Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                <ProgressBar Width="220" Height="4" IsIndeterminate="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>