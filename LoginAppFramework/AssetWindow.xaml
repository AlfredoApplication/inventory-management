<Window x:Class="LoginAppFramework.AssetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LoginAppFramework"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="Vəsait İdarəetməsi"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MainScreenWindowStyle}">

    <Window.Resources>
        <local:InvertedBooleanConverter x:Key="InvertedBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{StaticResource RowAlternateBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowSelectedBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModernNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#16A085" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="Transparent" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Storyboard x:Key="OpenMenu">
            <DoubleAnimation Storyboard.TargetName="SlideOutMenu" Storyboard.TargetProperty="Width" To="260" Duration="0:0:0.3"/>
        </Storyboard>
        <Storyboard x:Key="CloseMenu">
            <DoubleAnimation Storyboard.TargetName="SlideOutMenu" Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.3"/>
        </Storyboard>
        <Style x:Key="FilterHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource GlassBackgroundBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MenuButton" Style="{StaticResource PrimaryActionButton}" Height="40" Padding="15,0" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE700;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Menyu" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Vəsait İdarəetməsi" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="AssetCountTextBlock" Text="{Binding AssetCountText}" HorizontalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="FilterPanelToggleButton"
                                Content="Filtrləri Gizlət"
                                Click="ToggleFilterPanelButton_Click"
                                Margin="0,0,10,0"/>
                        <Button x:Name="ExportButton" Click="ExportButton_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74E;" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                <TextBlock Text="Excel-ə Export"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ImportButton" Click="ImportButton_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B0;" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                <TextBlock Text="Excel-dən Import"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddAssetButton" Click="AddAssetButton_Click" Style="{StaticResource PrimaryActionButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Text="&#xE710;"/>
                                <TextBlock Text="Yeni Vəsait Əlavə et"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FilterColumn" Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="FilterSidebar" Grid.Column="0" Background="{StaticResource GlassBackgroundBrush}" Padding="15" BorderThickness="0,0,1,0" BorderBrush="{StaticResource GlassBorderBrush}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="FILTRLƏR" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="ClearFiltersButton" Content="Hamısını Təmizlə" Click="ClearFiltersButton_Click" Margin="10,0,0,0"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <StackPanel x:Name="FilterPanel" DataContext="{Binding Filters}">
                                <TextBlock Text="Ad/Seriya üzrə Axtarış" Style="{StaticResource FilterHeader}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="Axtarış..."/>

                                <TextBlock Text="Kateqoriya" Style="{StaticResource FilterHeader}" Margin="0,15,0,5"/>
                                <CheckBox Content="Yalnız Kateqoriyasız Vəsaitlər" IsChecked="{Binding ShowOnlyUncategorized, Mode=TwoWay}" Margin="0,0,0,10" ToolTip="Mövcud kateqoriya siyahısına aid olmayan vəsaitləri göstərin."/>
                                <TreeView ItemsSource="{Binding CategoryTree}" Background="Transparent" BorderThickness="0" IsEnabled="{Binding ShowOnlyUncategorized, Converter={StaticResource InvertedBooleanConverter}}">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Subcategories}">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>

                                <StackPanel>
                                    <Expander Header="Status" IsExpanded="True" Margin="0,15,0,0">
                                        <ItemsControl ItemsSource="{Binding StatusOptions}" Margin="10,5,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>

                                    <Expander Header="Departament" IsExpanded="True" Margin="0,15,0,0">
                                        <ItemsControl ItemsSource="{Binding DepartmentOptions}" Margin="10,5,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#EAECEE" Padding="5" MinHeight="30">
                        <ItemsControl x:Name="ActiveFiltersPanel" ItemsSource="{Binding ActiveFilterTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="LightGray" CornerRadius="10" Margin="2" Padding="8,3">
                                        <TextBlock Text="{Binding}" Foreground="Black"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <Border Grid.Row="1" x:Name="BulkActionPanel" Background="#EDF2F7" Padding="8" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="0,0,0,1"
                            Visibility="{Binding HasCheckedAssets, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SelectionCountText" Text="{Binding CheckedCountText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0,20,0"/>
                            <Button x:Name="BulkDeleteButton" Content="Seçilmişləri Sil" Click="BulkDeleteButton_Click" Background="{StaticResource DangerBrush}" Foreground="{StaticResource PrimaryForegroundBrush}" Padding="8,4" Margin="0,0,10,0"/>
                            <Button x:Name="BulkEditButton" Content="Seçilmişləri Dəyiş" Click="BulkEditButton_Click" Style="{StaticResource PrimaryActionButton}" Padding="8,4" Margin="0,0,10,0"/>
                            <Button x:Name="BulkAssignButton" Content="Seçilmişləri Təhkim et..." Click="BulkAssignButton_Click" Background="{StaticResource SuccessBrush}" Foreground="{StaticResource PrimaryForegroundBrush}" Padding="8,4" Margin="0,0,10,0"/>
                            <Button x:Name="GenerateBarcodesButton" Click="GenerateBarcodesButton_Click" Style="{StaticResource PrimaryActionButton}" Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72D;" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Barkod Çap Et"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Row="2" x:Name="AssetsDataGrid" ItemsSource="{Binding VisibleAssets}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionChanged="AssetsDataGrid_SelectionChanged" AlternationCount="2">
                        <DataGrid.Resources>
                            <ContextMenu x:Key="CellContextMenu">
                                <MenuItem Header="Kopyala" Click="CopyCellContent_Click"/>
                            </ContextMenu>
                        </DataGrid.Resources>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="ContextMenu" Value="{StaticResource CellContextMenu}"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox x:Name="SelectAllCheckBox"
                                              Content="Seç"
                                              IsChecked="{Binding DataContext.AreAllVisibleChecked, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Vəsaitin Kodu with filter -->
                            <DataGridTextColumn Binding="{Binding VesaitinKodu, TargetNullValue='-'}" MinWidth="90" Width="110">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Vəsaitin Kodu" VerticalAlignment="Center"/>
                                        <local:ColumnFilterControl Grid.Column="1" x:Name="VesaitinKoduFilter"/>
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <!-- Vəsaitin Adı with filter -->
                            <DataGridTextColumn Binding="{Binding VesaitinAdi, TargetNullValue='-'}" MinWidth="150" Width="1.4*">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Vəsaitin Adı" VerticalAlignment="Center"/>
                                        <local:ColumnFilterControl Grid.Column="1" x:Name="VesaitinAdiFilter"/>
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Seriya Nömrəsi" Binding="{Binding ITAvadanliqlarininSeriyaNomresi, TargetNullValue='-'}" MinWidth="120" Width="145"/>

                            <!-- Kateqoriya with filter -->
                            <DataGridTextColumn Binding="{Binding Kateqoriya, TargetNullValue='-'}" MinWidth="110" Width="130">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Kateqoriya" VerticalAlignment="Center"/>
                                        <local:ColumnFilterControl Grid.Column="1" x:Name="KateqoriyaFilter"/>
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <!-- Təhkim Olunan Əməkdaş with filter -->
                            <DataGridTextColumn Binding="{Binding Worker.per_adiper_soyadi, TargetNullValue='(Boşdur)'}" MinWidth="150" Width="165">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Təhkim Olunan Əməkdaş" VerticalAlignment="Center"/>
                                        <local:ColumnFilterControl Grid.Column="1" x:Name="WorkerFilter"/>
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Vəzifəsi" Binding="{Binding Worker.pgk_gorev_adi, TargetNullValue='-'}" MinWidth="110" Width="135"/>

                            <!-- Bölmə/Şöbə/Departament with filter -->
                            <DataGridTextColumn Binding="{Binding Worker.pdp_adi, TargetNullValue='-'}" MinWidth="140" Width="165">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Bölmə/Şöbə/Departament" VerticalAlignment="Center"/>
                                        <local:ColumnFilterControl Grid.Column="1" x:Name="DepartmentFilter"/>
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <!-- Yerləşmə Yeri with filter -->
                            <DataGridTextColumn Binding="{Binding YerleshmeYeri, TargetNullValue='-'}" MinWidth="110" Width="130">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Yerləşmə Yeri" VerticalAlignment="Center"/>
                                        <local:ColumnFilterControl Grid.Column="1" x:Name="YerleshmeYeriFilter"/>
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <!-- Ərazi with filter -->
                            <DataGridTextColumn Binding="{Binding Erazi, TargetNullValue='-'}" MinWidth="90" Width="105">
                                <DataGridTextColumn.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Ərazi" VerticalAlignment="Center"/>
                                        <local:ColumnFilterControl Grid.Column="1" x:Name="EraziFilter"/>
                                    </Grid>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" x:Name="NoResultsTextBlock" Text="Heç bir vəsait tapılmadı." HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResults}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Border Grid.Column="1" x:Name="DetailPanelContainer" HorizontalAlignment="Right" Width="0" Background="{StaticResource GlassBackgroundBrush}" BorderThickness="1,0,0,0" BorderBrush="{StaticResource GlassBorderBrush}">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.1" Direction="-90"/>
                    </Border.Effect>
                    <local:AssetDetailControl x:Name="AssetDetailControl" />
                </Border>
            </Grid>
        </DockPanel>
        <local:MainNavigationMenu x:Name="SharedNavigationMenu" CurrentPage="Assets"/>
        <Border x:Name="LoadingOverlay" Background="{StaticResource GlassBackgroundBrush}" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Vəsaitlər Yüklənir..." FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="Zəhmət olmasa, məlumatlar hazırlanarkən gözləyin." Foreground="{StaticResource BodyTextBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>