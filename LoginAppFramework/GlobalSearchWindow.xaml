<Window x:Class="LoginAppFramework.GlobalSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LoginAppFramework"
        Title="Qlobal Axtarış"
        Width="820"
        Height="680"
        MinWidth="660"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="SearchScopeRadioStyle"
               TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ScopeBorder"
                                Background="{StaticResource PanelBackgroundBrush}"
                                BorderBrush="{StaticResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ScopeBorder"
                                        Property="Background"
                                        Value="{StaticResource RowSelectedBrush}"/>
                                <Setter TargetName="ScopeBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource PrimaryTextBrush}"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ScopeBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrushHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource SurfaceCardStyle}"
            Margin="22"
            Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="20,18"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="Qlobal Axtarış"
                               Style="{StaticResource PageTitleTextStyle}"/>
                    <TextBlock Text="Vəsait və işçiləri kod, ad, seriya, status, vəzifə və departament üzrə tapın. Kiçik yazı səhvləri də nəzərə alınır."
                               Style="{StaticResource PageSubtitleTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Padding="20,14"
                    Background="{StaticResource SurfaceMutedBrush}"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBox x:Name="SearchBox"
                             Height="42"
                             Tag="Kod, ad, seriya, işçi..."
                             TextChanged="SearchBox_TextChanged"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Növ:"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       Margin="0,0,9,0"/>
                            <RadioButton x:Name="AllScopeRadio"
                                         Content="Hamısı"
                                         Tag="All"
                                         GroupName="SearchScope"
                                         IsChecked="True"
                                         Style="{StaticResource SearchScopeRadioStyle}"
                                         Checked="SearchScope_Checked"/>
                            <RadioButton Content="Vəsaitlər"
                                         Tag="Asset"
                                         GroupName="SearchScope"
                                         Style="{StaticResource SearchScopeRadioStyle}"
                                         Checked="SearchScope_Checked"/>
                            <RadioButton Content="İşçilər"
                                         Tag="Worker"
                                         GroupName="SearchScope"
                                         Style="{StaticResource SearchScopeRadioStyle}"
                                         Checked="SearchScope_Checked"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="↑ ↓ seç • Enter aç • Esc bağla"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{StaticResource SubtleTextBrush}"/>
                    </Grid>

                    <StackPanel x:Name="RecentSearchesPanel"
                                Orientation="Horizontal"
                                Margin="0,11,0,0"
                                Visibility="Collapsed">
                        <TextBlock Text="Son axtarışlar:"
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <ItemsControl x:Name="RecentSearchesItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}"
                                            Padding="8,3"
                                            Margin="0,0,6,4"
                                            FontSize="11"
                                            Click="RecentSearchButton_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <ListView x:Name="ResultsListView"
                          BorderThickness="0"
                          SelectionChanged="ResultsListView_SelectionChanged"
                          MouseDoubleClick="ResultsListView_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,11"
                                    BorderBrush="{StaticResource ControlBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="38"
                                            Height="38"
                                            CornerRadius="10"
                                            Background="{StaticResource SurfaceMutedBrush}"
                                            Margin="0,0,12,0">
                                        <local:AppIcon Icon="{Binding Icon}"
                                                       Size="20"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <local:HighlightTextBlock Text="{Binding Title}"
                                                                  Highlight="{Binding Highlight}"
                                                                  TextFontSize="14"
                                                                  TextFontWeight="SemiBold"
                                                                  TextForeground="{StaticResource PrimaryTextBrush}"/>
                                        <local:HighlightTextBlock Text="{Binding Subtitle}"
                                                                  Highlight="{Binding Highlight}"
                                                                  TextFontSize="12"
                                                                  TextForeground="{StaticResource SubtleTextBrush}"
                                                                  Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Background="{StaticResource RowSelectedBrush}"
                                            CornerRadius="10"
                                            Padding="9,4"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TypeLabel}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <local:EmptyStateControl x:Name="EmptyStatePanel"
                                         Icon="Search"
                                         Title="Axtarışa başlayın"
                                         Message="Yuxarıdakı sahəyə axtardığınız kodu və ya adı yazın."/>
            </Grid>

            <Border Grid.Row="3"
                    Padding="16,12"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock x:Name="ResultCountTextBlock"
                               Foreground="{StaticResource SubtleTextBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Bağla"
                                MinWidth="90"
                                Margin="0,0,10,0"
                                IsCancel="True"
                                Click="CloseButton_Click"/>
                        <Button x:Name="OpenButton"
                                Content="Detalları aç"
                                MinWidth="110"
                                IsEnabled="False"
                                Style="{StaticResource PrimaryActionButton}"
                                Click="OpenButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
