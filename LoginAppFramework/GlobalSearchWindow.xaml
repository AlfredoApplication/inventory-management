<Window x:Class="LoginAppFramework.GlobalSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LoginAppFramework"
        Title="Qlobal Axtarış"
        Width="760"
        Height="620"
        MinWidth="620"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Style="{StaticResource SurfaceCardStyle}"
            Margin="22"
            Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="20,18"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="Qlobal Axtarış"
                               Style="{StaticResource PageTitleTextStyle}"/>
                    <TextBlock Text="Vəsait və işçiləri kod, ad, seriya, status, vəzifə və departament üzrə tapın."
                               Style="{StaticResource PageSubtitleTextStyle}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Padding="20,16"
                    Background="{StaticResource SurfaceMutedBrush}"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="0,0,0,1">
                <TextBox x:Name="SearchBox"
                         Height="42"
                         Tag="Kod, ad, seriya, işçi..."
                         TextChanged="SearchBox_TextChanged"/>
            </Border>

            <Grid Grid.Row="2">
                <ListView x:Name="ResultsListView"
                          BorderThickness="0"
                          SelectionChanged="ResultsListView_SelectionChanged"
                          MouseDoubleClick="ResultsListView_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,11"
                                    BorderBrush="{StaticResource ControlBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="38"
                                            Height="38"
                                            CornerRadius="10"
                                            Background="{StaticResource SurfaceMutedBrush}"
                                            Margin="0,0,12,0">
                                        <local:AppIcon Icon="{Binding Icon}"
                                                       Size="20"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource SubtleTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Background="{StaticResource RowSelectedBrush}"
                                            CornerRadius="10"
                                            Padding="9,4"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TypeLabel}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <local:EmptyStateControl x:Name="EmptyStatePanel"
                                         Icon="Search"
                                         Title="Axtarışa başlayın"
                                         Message="Yuxarıdakı sahəyə axtardığınız kodu və ya adı yazın."/>
            </Grid>

            <Border Grid.Row="3"
                    Padding="16,12"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock x:Name="ResultCountTextBlock"
                               Foreground="{StaticResource SubtleTextBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Bağla"
                                MinWidth="90"
                                Margin="0,0,10,0"
                                IsCancel="True"
                                Click="CloseButton_Click"/>
                        <Button x:Name="OpenButton"
                                Content="Detalları aç"
                                MinWidth="110"
                                IsEnabled="False"
                                Style="{StaticResource PrimaryActionButton}"
                                Click="OpenButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
