<Window x:Class="LoginAppFramework.ImportMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excel İşçilərinin Uyğunlaşdırılması" Height="600" Width="800"
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow"
        Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI">
    <Border Style="{StaticResource SurfaceCardStyle}" Margin="15" Padding="18">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold" Text="İşçi uyğunlaşdırılması tələb olunur" Foreground="{StaticResource PrimaryTextBrush}"/>
        <TextBlock Grid.Row="1" Margin="0,5,0,15" TextWrapping="Wrap" Foreground="{StaticResource BodyTextBrush}" Text="Excel faylındakı bəzi işçi adları avtomatik uyğunlaşdırılmadı. Hər ad üçün verilənlər bazasındakı düzgün işçini seçin."/>

        <DataGrid Grid.Row="2" x:Name="MappingDataGrid" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Excel faylındakı ad" Binding="{Binding ExcelUserName}" IsReadOnly="True" Width="2*" />
                <DataGridTemplateColumn Header="Uyğun işçi" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding AllDbWorkers}"
                                      SelectedItem="{Binding SelectedDbWorker, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="per_adiper_soyadi"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      StaysOpenOnEdit="True" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Uyğunlaşdır və Import Et" Style="{StaticResource PrimaryActionButton}" Click="ConfirmButton_Click" />
            <Button Content="Ləğv et" IsCancel="True" Margin="10,0,0,0" />
        </StackPanel>
        </Grid>
    </Border>
</Window>