<Window x:Class="LoginAppFramework.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LoginAppFramework"
        Title="Hesabat Mərkəzi"
        Width="1120"
        Height="780"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="ReportKindCardStyle"
               TargetType="RadioButton">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card"
                                Background="{StaticResource PanelBackgroundBrush}"
                                BorderBrush="{StaticResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card"
                                        Property="Background"
                                        Value="{StaticResource RowSelectedBrush}"/>
                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrushHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Style="{StaticResource SurfaceCardStyle}"
                Margin="20"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="20,18"
                        BorderBrush="{StaticResource ControlBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="Hesabat Mərkəzi"
                                   Style="{StaticResource PageTitleTextStyle}"/>
                        <TextBlock Text="Hesabat növünü seçin, ortaq filterləri tətbiq edin və nəticəni Excel və ya PDF kimi çıxarın."
                                   Style="{StaticResource PageSubtitleTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <UniformGrid Grid.Row="1"
                             Columns="3"
                             Margin="14,10,14,6">
                    <RadioButton x:Name="InventoryReportRadio"
                                 GroupName="ReportKind"
                                 IsChecked="True"
                                 Tag="Inventory"
                                 Style="{StaticResource ReportKindCardStyle}"
                                 Checked="ReportKind_Checked">
                        <StackPanel>
                            <TextBlock Text="Ümumi İnventar"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="Bütün aktiv məlumatlar"
                                       FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="ReportKind"
                                 Tag="Purchases"
                                 Style="{StaticResource ReportKindCardStyle}"
                                 Checked="ReportKind_Checked">
                        <StackPanel>
                            <TextBlock Text="Alış Tarixi"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="Alış tarixlərinə görə"
                                       FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="ReportKind"
                                 Tag="Warranty"
                                 Style="{StaticResource ReportKindCardStyle}"
                                 Checked="ReportKind_Checked">
                        <StackPanel>
                            <TextBlock Text="Zəmanət"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="Bitən və yaxınlaşanlar"
                                       FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="ReportKind"
                                 Tag="Maintenance"
                                 Style="{StaticResource ReportKindCardStyle}"
                                 Checked="ReportKind_Checked">
                        <StackPanel>
                            <TextBlock Text="Texniki Xidmət"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="Vaxtı çatan və gecikənlər"
                                       FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="ReportKind"
                                 Tag="Lifecycle"
                                 Style="{StaticResource ReportKindCardStyle}"
                                 Checked="ReportKind_Checked">
                        <StackPanel>
                            <TextBlock Text="Həyat Dövrü"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="İstifadə müddəti bitənlər"
                                       FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="ReportKind"
                                 Tag="Unassigned"
                                 Style="{StaticResource ReportKindCardStyle}"
                                 Checked="ReportKind_Checked">
                        <StackPanel>
                            <TextBlock Text="Təhkim Olunmayıb"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="İşçisiz vəsaitlər"
                                       FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>

                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceMutedBrush}"
                        BorderBrush="{StaticResource ControlBorderBrush}"
                        BorderThickness="0,1,0,1"
                        Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Alış tarixi — başlanğıc"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="Alış tarixi — son"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="4"
                                   Text="Departament"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="6"
                                   Text="Kateqoriya"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>

                        <local:DateSelectorControl x:Name="PurchaseDateFromSelector"
                                                   Grid.Row="1"
                                                   Grid.Column="0"
                                                   AllowClear="True"
                                                   DialogTitle="Başlanğıc alış tarixini seçin"/>
                        <local:DateSelectorControl x:Name="PurchaseDateToSelector"
                                                   Grid.Row="1"
                                                   Grid.Column="2"
                                                   AllowClear="True"
                                                   DialogTitle="Son alış tarixini seçin"/>
                        <ComboBox x:Name="DepartmentComboBox"
                                  Grid.Row="1"
                                  Grid.Column="4"
                                  SelectionChanged="FilterSelectionChanged"/>
                        <ComboBox x:Name="CategoryComboBox"
                                  Grid.Row="1"
                                  Grid.Column="6"
                                  SelectionChanged="FilterSelectionChanged"/>
                        <Button Grid.Row="1"
                                Grid.Column="7"
                                Content="Filterləri sıfırla"
                                Margin="12,0,0,0"
                                Padding="12,7"
                                Click="ClearFiltersButton_Click"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="3"
                      Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="270"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock x:Name="CurrentReportTitleTextBlock"
                                           Style="{StaticResource SectionTitleTextStyle}"/>
                                <TextBlock x:Name="ResultSummaryTextBlock"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="StatusTextBlock"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource WarningTextBrush}"
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <DataGrid x:Name="PreviewDataGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      MouseDoubleClick="PreviewDataGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Kod"
                                                        Binding="{Binding VesaitinKodu}"
                                                        Width="105"/>
                                    <DataGridTextColumn Header="Vəsait"
                                                        Binding="{Binding VesaitinAdi}"
                                                        Width="1.5*"/>
                                    <DataGridTextColumn Header="Kateqoriya"
                                                        Binding="{Binding Kateqoriya}"
                                                        Width="125"/>
                                    <DataGridTextColumn Header="Əməkdaş"
                                                        Binding="{Binding AssignedUser}"
                                                        Width="145"/>
                                    <DataGridTextColumn Header="Departament"
                                                        Binding="{Binding Department}"
                                                        Width="145"/>
                                    <DataGridTextColumn Header="Status"
                                                        Binding="{Binding Status}"
                                                        Width="105"/>
                                    <DataGridTextColumn Header="Alış tarixi"
                                                        Binding="{Binding PurchaseDate, StringFormat=dd.MM.yyyy}"
                                                        Width="100"/>
                                    <DataGridTextColumn Header="Cari dəyər"
                                                        Binding="{Binding CurrentValue, StringFormat={}{0:N2} ₼}"
                                                        Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <local:EmptyStateControl x:Name="EmptyState"
                                                     Visibility="Collapsed"
                                                     Icon="Reports"
                                                     Title="Nəticə yoxdur"
                                                     Message="Seçilmiş hesabat və filterlərə uyğun vəsait tapılmadı."/>
                        </Grid>
                    </Grid>

                    <Border Grid.Column="2"
                            Background="{StaticResource SurfaceMutedBrush}"
                            BorderBrush="{StaticResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Son hesabatlar"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"/>
                                <TextBlock Text="Son 8 export konfiqurasiyası"
                                           FontSize="11"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="0,3,0,10"/>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="RecentReportsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Tag="{Binding}"
                                                        HorizontalContentAlignment="Stretch"
                                                        Padding="8"
                                                        Margin="0,0,0,7"
                                                        Click="RecentReportButton_Click">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Summary}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource SubtleTextBrush}"
                                                                   Margin="0,3,0,0"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding FilterSummary}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource SubtleTextBrush}"
                                                                   Margin="0,2,0,0"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock x:Name="RecentEmptyTextBlock"
                                           Text="Hələ export edilmiş hesabat yoxdur."
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="4"
                        Padding="14,12"
                        BorderBrush="{StaticResource ControlBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock Text="Sətirə iki dəfə klikləyərək vəsait detalını aça bilərsiniz."
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   FontSize="11"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button x:Name="ExportExcelButton"
                                    Content="Excel"
                                    MinWidth="100"
                                    Margin="0,0,8,0"
                                    Click="ExportExcelButton_Click"/>
                            <Button x:Name="ExportPdfButton"
                                    Content="PDF"
                                    MinWidth="100"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource PrimaryActionButton}"
                                    Click="ExportPdfButton_Click"/>
                            <Button Content="Bağla"
                                    MinWidth="90"
                                    IsCancel="True"
                                    Click="CloseButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <local:OperationProgressOverlay x:Name="OperationProgressOverlay"/>
    </Grid>
</Window>
