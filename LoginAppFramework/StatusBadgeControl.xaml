<UserControl x:Class="LoginAppFramework.StatusBadgeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Border x:Name="BadgeBorder"
            Background="{StaticResource SurfaceMutedBrush}"
            BorderBrush="{StaticResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="9,4"
            HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot"
                     Width="7"
                     Height="7"
                     Fill="{StaticResource SubtleTextBrush}"
                     VerticalAlignment="Center"
                     Margin="0,0,7,0"/>
            <TextBlock x:Name="StatusTextBlock"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SubtleTextBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
