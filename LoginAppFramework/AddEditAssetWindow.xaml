<Window x:Class="LoginAppFramework.AddEditAssetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vəsait Məlumatları" Height="Auto" Width="550" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" 
        Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="Vəsaitin Kodu:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding VesaitinKodu, Mode=TwoWay}" Margin="0,0,0,10" Padding="5"/>
            <Label Grid.Row="1" Content="Vəsaitin Adı:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding VesaitinAdi, Mode=TwoWay}" Margin="0,0,0,10" Padding="5"/>
            <Label Grid.Row="2" Content="Seriya Nömrəsi:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ITAvadanliqlarininSeriyaNomresi, Mode=TwoWay}" Margin="0,0,0,10" Padding="5"/>
            <Label Grid.Row="3" Content="Kateqoriya:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
            <ComboBox x:Name="CategoryComboBox" Grid.Row="3" Grid.Column="1" SelectedItem="{Binding Kateqoriya, Mode=TwoWay}" Margin="0,0,0,10" Padding="5" SelectionChanged="CategoryComboBox_SelectionChanged"/>
            <Label Grid.Row="4" Content="Təhkim Olunan Əməkdaş:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
            <ComboBox x:Name="UserComboBox" Grid.Row="4" Grid.Column="1" DisplayMemberPath="per_adiper_soyadi" Margin="0,0,0,10" Padding="5" IsEditable="True" IsTextSearchEnabled="True"
                      SelectionChanged="UserComboBox_SelectionChanged"/>
            <Label Grid.Row="5" Content="Bölmə/Şöbə/Departament:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
            <ComboBox x:Name="DepartmentComboBox" Grid.Row="5" Grid.Column="1" SelectedItem="{Binding BolmeShobeDepartment, Mode=TwoWay}" IsEditable="True" Margin="0,0,0,10" Padding="5"/>
            <Label Grid.Row="6" Content="Yerləşmə Yeri:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding YerleshmeYeri, Mode=TwoWay}" Margin="0,0,0,10" Padding="5"/>
            <Label Grid.Row="7" Content="Ərazi:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Erazi, Mode=TwoWay}" Margin="0,0,0,10" Padding="5"/>
            <Label Grid.Row="8" Content="Status:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
            <ComboBox x:Name="StatusComboBox" Grid.Row="8" Grid.Column="1" Margin="0,0,0,10" Padding="5"
                      SelectionChanged="StatusComboBox_SelectionChanged"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- ADDED ONE MORE ROW DEFINITION -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Separator Grid.Row="0" Grid.ColumnSpan="2" Margin="0,5,0,10"/>
            <Label Grid.Row="1" Content="Alış Qiyməti:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PurchaseCost, Mode=TwoWay}" Margin="0,0,0,10" Padding="5"/>
            <Label Grid.Row="2" Content="Alınma Tarixi:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <DatePicker Grid.Row="2" Grid.Column="1" SelectedDate="{Binding PurchaseDate, Mode=TwoWay}" Margin="0,0,0,10" Padding="5"/>
            <Label Grid.Row="3" Content="Təchizatçı:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Supplier, Mode=TwoWay}" Margin="0,0,0,10" Padding="5"/>
            <Label Grid.Row="4" Content="Zəmanət Müddəti:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <DatePicker Grid.Row="4" Grid.Column="1" SelectedDate="{Binding WarrantyExpirationDate, Mode=TwoWay}" Margin="0,0,0,10" Padding="5"/>

            <!-- THE FIX: This field is now correctly included -->
            <Label Grid.Row="5" Content="İstifadə müddəti (İl):" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding UsefulLifeInYears, Mode=TwoWay}" Margin="0,0,0,10" Padding="5"/>
        </Grid>
        <StackPanel Grid.Row="2" x:Name="CustomFieldsSeparator" Visibility="Collapsed">
            <Separator Margin="0,10"/>
            <TextBlock Text="Kateqoriyaya Xas Məlumatlar" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,10"/>
        </StackPanel>
        <StackPanel x:Name="CustomFieldsPanel" Grid.Row="3"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Yadda Saxla" Width="100" Margin="0,0,10,0" Padding="10,5" Style="{StaticResource PrimaryActionButton}" Click="SaveButton_Click"/>
            <Button Content="Ləğv et" Width="80" Padding="10,5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>