<Window x:Class="LoginAppFramework.AddEditAssetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LoginAppFramework"
        Title="Vəsait Məlumatları"
        Width="660"
        Height="760"
        MinWidth="520"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Border Style="{StaticResource SurfaceCardStyle}" Margin="24" Padding="24">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Content="Vəsaitin Kodu:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding VesaitinKodu, Mode=TwoWay}" Margin="0,0,0,10" Padding="10,7"/>

                    <Label Grid.Row="1" Content="Vəsaitin Adı:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
                    <TextBox x:Name="AssetNameTextBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding VesaitinAdi, Mode=TwoWay}"
                             Margin="0,0,0,10"
                             Padding="10,7"/>

                    <Label Grid.Row="2" Content="Seriya Nömrəsi:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ITAvadanliqlarininSeriyaNomresi, Mode=TwoWay}" Margin="0,0,0,10" Padding="10,7"/>

                    <Label Grid.Row="3" Content="Kateqoriya:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CategoryComboBox"
                              Grid.Row="3"
                              Grid.Column="1"
                              SelectedItem="{Binding Kateqoriya, Mode=TwoWay}"
                              Margin="0,0,0,10"
                              Padding="10,7"
                              SelectionChanged="CategoryComboBox_SelectionChanged"/>

                    <Label Grid.Row="4" Content="Təhkim Olunan Əməkdaş:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
                    <ComboBox x:Name="UserComboBox"
                              Grid.Row="4"
                              Grid.Column="1"
                              DisplayMemberPath="DisplayName"
                              TextSearch.TextPath="DisplayName"
                              Margin="0,0,0,10"
                              Padding="10,7"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              StaysOpenOnEdit="True"
                              SelectionChanged="UserComboBox_SelectionChanged"
                              LostKeyboardFocus="UserComboBox_LostKeyboardFocus"/>

                    <Label Grid.Row="5" Content="Bölmə/Şöbə/Departament:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
                    <TextBox x:Name="AssignedDepartmentTextBox"
                             Grid.Row="5"
                             Grid.Column="1"
                             IsReadOnly="True"
                             IsTabStop="False"
                             Margin="0,0,0,10"
                             Padding="10,7"
                             ToolTip="Departament seçilmiş əməkdaşdan avtomatik müəyyən edilir."/>

                    <Label Grid.Row="6" Content="Yerləşmə Yeri:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding YerleshmeYeri, Mode=TwoWay}" Margin="0,0,0,10" Padding="10,7"/>

                    <Label Grid.Row="7" Content="Ərazi:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Erazi, Mode=TwoWay}" Margin="0,0,0,10" Padding="10,7"/>

                    <Label Grid.Row="8" Content="Status:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="SemiBold"/>
                    <ComboBox x:Name="StatusComboBox"
                              Grid.Row="8"
                              Grid.Column="1"
                              Margin="0,0,0,10"
                              Padding="10,7"
                              SelectionChanged="StatusComboBox_SelectionChanged"/>
                </Grid>

                <Separator Margin="0,5,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Content="Alış Qiyməti:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PurchaseCost, Mode=TwoWay}" Margin="0,0,0,10" Padding="10,7"/>

                    <Label Grid.Row="1" Content="Alınma Tarixi:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <local:DateSelectorControl x:Name="PurchaseDateSelector"
                                               Grid.Row="1"
                                               Grid.Column="1"
                                               Margin="0,0,0,10"
                                               AllowClear="False"
                                               DialogTitle="Alınma tarixini seçin"/>

                    <Label Grid.Row="2" Content="Təchizatçı:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Supplier, Mode=TwoWay}" Margin="0,0,0,10" Padding="10,7"/>

                    <Label Grid.Row="3" Content="Zəmanət Müddəti:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <local:DateSelectorControl x:Name="WarrantyDateSelector"
                                               Grid.Row="3"
                                               Grid.Column="1"
                                               Margin="0,0,0,10"
                                               AllowClear="True"
                                               DialogTitle="Zəmanət bitmə tarixini seçin"/>

                    <Label Grid.Row="4" Content="İstifadə müddəti (İl):" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding UsefulLifeInYears, Mode=TwoWay}" Margin="0,0,0,10" Padding="10,7"/>
                </Grid>

                <StackPanel x:Name="CustomFieldsSeparator" Visibility="Collapsed">
                    <Separator Margin="0,10"/>
                    <TextBlock Text="Kateqoriyaya Xas Məlumatlar"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Margin="0,0,0,10"/>
                </StackPanel>

                <StackPanel x:Name="CustomFieldsPanel"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                BorderBrush="{StaticResource ControlBorderBrush}"
                BorderThickness="0,1,0,0"
                Margin="0,12,0,0"
                Padding="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="ValidationTextBlock"
                           Grid.Row="0"
                           Visibility="Collapsed"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Yadda Saxla"
                            Width="110"
                            Margin="0,0,10,0"
                            Padding="10,5"
                            Style="{StaticResource PrimaryActionButton}"
                            IsDefault="True"
                            Click="SaveButton_Click"/>
                    <Button Content="Ləğv et"
                            Width="90"
                            Padding="10,5"
                            IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
    </Border>
</Window>