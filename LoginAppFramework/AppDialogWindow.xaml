<Window x:Class="LoginAppFramework.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LoginAppFramework"
        Title="Bildiriş"
        Width="460"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI">
    <Border Style="{StaticResource SurfaceCardStyle}"
            Margin="18"
            Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="IconContainer"
                        Width="44"
                        Height="44"
                        CornerRadius="12"
                        Background="{StaticResource InfoSurfaceBrush}"
                        BorderBrush="{StaticResource InfoBorderBrush}"
                        BorderThickness="1"
                        Margin="0,0,14,0">
                    <local:AppIcon x:Name="IconVisual"
                                   Icon="Info"
                                   Size="22"
                                   Foreground="{StaticResource InfoTextBrush}"/>
                </Border>

                <TextBlock x:Name="TitleTextBlock"
                           Grid.Column="1"
                           Text="Bildiriş"
                           Style="{StaticResource SectionTitleTextStyle}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          MaxHeight="430"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,18,0,20">
                <TextBlock x:Name="MessageTextBlock"
                           TextWrapping="Wrap"
                           FontSize="14"
                           LineHeight="21"
                           Foreground="{StaticResource BodyTextBrush}"/>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="SecondaryButton"
                        Content="Ləğv et"
                        MinWidth="100"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Click="SecondaryButton_Click"/>
                <Button x:Name="PrimaryButton"
                        Content="OK"
                        MinWidth="100"
                        IsDefault="True"
                        Style="{StaticResource PrimaryActionButton}"
                        Click="PrimaryButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>